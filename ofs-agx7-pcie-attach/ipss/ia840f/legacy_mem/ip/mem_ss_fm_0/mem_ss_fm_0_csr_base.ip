            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_ctlp_lo</ipxact:name>
          <ipxact:displayName>mem_ss_base_ctlp_lo</ipxact:displayName>
          <ipxact:description>Control Policy (lower DWORD)</ipxact:description>
          <ipxact:addressOffset>0x90</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>ctlp</ipxact:name>
            <ipxact:displayName>ctlp</ipxact:displayName>
            <ipxact:description>Control Policy (CTLP):This access control policy register set applies to all of Registers.Bit wise register where each bit represent the 6-bit SAI Index that mapped to a particular 8-bit SAI value or values.A value 1 in this register bit means that a configuration cycle with SAI value that match the mapped 8-bit SAI value or values has the write access to the CTLP , RACCTLP and WACCTLP register.A value 0 in this register bit means that a configuration cycle with SAI value that match the mapped 8-bit SAI value or values has no the write access to the CTLP, RACCTLP and WACCTLP register.Configuration cycle to the CTLP register and ACCTLP register always has read access disregard of the value of this register.The default value is determined by input port SAI_CTLP_XXXX [63:0].</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_ctlp_hi</ipxact:name>
          <ipxact:displayName>mem_ss_base_ctlp_hi</ipxact:displayName>
          <ipxact:description>Control Policy (upper DWORD)</ipxact:description>
          <ipxact:addressOffset>0x94</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>ctlp</ipxact:name>
            <ipxact:displayName>ctlp</ipxact:displayName>
            <ipxact:description>Control Policy (CTLP)</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_racctlp_lo</ipxact:name>
          <ipxact:displayName>mem_ss_base_racctlp_lo</ipxact:displayName>
          <ipxact:description>Read Access Control Policy (lower DWORD)</ipxact:description>
          <ipxact:addressOffset>0x98</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>racctlp</ipxact:name>
            <ipxact:displayName>racctlp</ipxact:displayName>
            <ipxact:description>Read Access Control Policy (RACCTLP):Bit wise register where each bit represent the 6-bit SAI Index that mapped to a particular 8-bit SAI value or values.A value 1 in this register bit means that a cycle with SAI value that match the mapped 8-bit SAI value or values has read access to the configuration register space or memory-mapped IO register space.A value 0 in this register bit means that a cycle with SAI value that match the mapped 8-bit SAI value or values does not have read access.The default value is determined by input port SAI_RACCTLP_XXXX[63:0].</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_racctlp_hi</ipxact:name>
          <ipxact:displayName>mem_ss_base_racctlp_hi</ipxact:displayName>
          <ipxact:description>Read Access Control Policy (upper DWORD)</ipxact:description>
          <ipxact:addressOffset>0x9c</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>racctlp</ipxact:name>
            <ipxact:displayName>racctlp</ipxact:displayName>
            <ipxact:description>Read Access Control Policy (RACCTLP)</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_wacctlp_lo</ipxact:name>
          <ipxact:displayName>mem_ss_base_wacctlp_lo</ipxact:displayName>
          <ipxact:description>Write Access Control Policy (lower DWORD)</ipxact:description>
          <ipxact:addressOffset>0xa0</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>wacctlp</ipxact:name>
            <ipxact:displayName>wacctlp</ipxact:displayName>
            <ipxact:description>Write Access Control Policy (WACCTLP):Bit wise register where each bit represent the 6-bit SAI Index that mapped to a particular 8-bit SAI value or values.A value 1 in this register bit means that a cycle with SAI value that match the mapped 8-bit SAI value or values has write access to the configuration register space and memory-mapped IO register space.A value 0 in this register bit means that a cycle with SAI value that match the mapped 8-bit SAI value or values does not have write access.The default value is determined by input port SAI_WACCTLP_XXXX[63:0].</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>mem_ss_base_wacctlp_hi</ipxact:name>
