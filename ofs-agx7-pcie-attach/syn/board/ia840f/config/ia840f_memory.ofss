# Vendor-derived two-channel source preset, NOT qualified for generation.
# See ipss/ia840f/preset_derivation.json and docs/vendor-derived-presets.md.
[ip]
type = memory

[settings]
output_name = mem_ss
preset = ia840f_discrete_rdimm_source
# OFS mixed-memory reference: tools/ofss_config/memory/memory_rtile_8g_rdimm.ofss.
# Requests separate discrete/RDIMM simulation models; does not select a preset
# or prove the generated physical interface groups/pin mapping.
memory_groups = 2
