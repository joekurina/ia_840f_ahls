uty_cycle] [-edge_shifts] [-edges] [-fall] [-is_inverted] [-latency] [-master_cl
ock] [-master_clock_pin] [-max] [-min] [-multiply_by] [-name] [-nreg_neg] [-nreg
_pos] [-offset] [-period] [-phase] [-rise] [-targets] [-type] [-waveform] <clk_o
bject>

