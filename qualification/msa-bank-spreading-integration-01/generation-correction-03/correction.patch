+def terminate_stage_group(child):
+    import signal
+
+    # start_new_session=True makes this unreaped child the PGID/session leader.
+    # Do not poll/wait/reap it before the final group signal: even if TERM exits
+    # the launcher, its PID stays reserved and cannot identify a recycled group.
+    pgid = child.pid
+    try: os.killpg(pgid, signal.SIGTERM)
+    except ProcessLookupError: pass
+    time.sleep(10)  # Full bounded TERM grace, independent of launcher exit.
+    try: os.killpg(pgid, signal.SIGKILL)
+    except ProcessLookupError: pass
+
+    # KILL delivery is asynchronous. Observe this group quiesce before returning;
+    # zombies are dead, not surviving writers. Keep the leader unreaped here too.
+    deadline = time.monotonic() + 10
+    while True:
+        live = False
+        for entry in Path('/proc').iterdir():
+            if not entry.name.isdigit(): continue
+            try: fields = (entry / 'stat').read_text().rsplit(')', 1)[1].split()
+            except (FileNotFoundError, ProcessLookupError): continue
+            if int(fields[2]) == pgid and fields[0] not in ('Z', 'X'):
+                live = True
+                break
+        if not live or time.monotonic() >= deadline: break
+        time.sleep(0.01)
+    # Do not turn an uninterruptible survivor into an unbounded wait or replace
+    # the original rc124. Record unsuccessful cleanup in the stage result.
+    if not live: child.wait()
+    return not live
+
