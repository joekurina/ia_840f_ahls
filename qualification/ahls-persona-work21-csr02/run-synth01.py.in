env={'HOME':str(R/'home'),'USER':'uwb_student00','LOGNAME':'uwb_student00','LANG':'C','PATH':str(qroot/'bin')+':'+str(qroot/'sopc_builder/bin')+':/usr/bin:/bin','TMPDIR':str(R/'tmp'),'QUARTUS_ROOTDIR_OVERRIDE':str(qroot),'LM_LICENSE_FILE':lic,'MGLS_LICENSE_FILE':lic,'SALT_LICENSE_SERVER':lic,'PYTHONDONTWRITEBYTECODE':'1','OPAE_PLATFORM_ROOT':str(T),'BUILD_ROOT_REL':'../../../..','PR_COMPILE':'1'}
