  n=str(p.relative_to(R));b=p.read_bytes();assert len(b)<120_000_000;e={'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()};result['files'][n]={**e,'base64':base64.b64encode(b).decode()};result['output_hashes'][n]=e
 result['qdb_outputs']={str(p.relative_to(J)):{'bytes':p.stat().st_size,'sha256':sha(p)} for p in (J/'qdb').rglob('*') if p.is_file()}
 log=(R/'synthesis.log').read_text(errors='replace') if (R/'synthesis.log').exists() else ''
 result['diagnostics']=[l for l in log.splitlines() if re.search(r'\b(?:Error|Fatal)(?:\s+\([^)]*\))?\s*:',l,re.I) or 'IA840F_GATE_REJECTED' in l]
 result['success_marker']='Quartus Prime Synthesis was successful' in log
 result['success']=result['complete'] and 'error' not in result and len(result['commands'])==1 and result['commands'][0].get('effective_rc')==0 and not result['diagnostics'] and result['success_marker'] and not result['postflight_errors'] and all(result.get(k) is True for k in ('setup_unchanged','release_unchanged','tools_unchanged','bound_inputs_unchanged'))
 result['ended']=datetime.now(timezone.utc).isoformat();persist();blob=gzip.compress(json.dumps(result,sort_keys=True).encode(),mtime=0);(R/'result.json.gz').write_bytes(blob)
 subprocess.run(['tmux','load-buffer','-b','ia840f_persona_csr02_synth01','-'],input=blob,check=True);subprocess.run(['tmux','set-buffer','-b','ia840f_persona_csr02_synth01_sha256',hashlib.sha256(blob).hexdigest()],check=True)
rc=result['commands'][-1].get('effective_rc',125) if result['commands'] else 125
if not result['success']:rc=rc or 125
