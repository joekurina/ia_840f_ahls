 if e.get('kind')!='file' or not n.endswith('.xml') or n.startswith('syn/board/ia840f/syn_top/output_files/'):continue
 p=D/n;old=p.read_bytes();unmapped=[]
 def relocate(m):
  suffix=m.group(1).decode();q=D/suffix.lstrip('/')
  if q.exists() and q.resolve().is_relative_to(D):return (str(D)+suffix).encode()
  unmapped.append(m.group().decode());return m.group()
 new=rx.sub(relocate,old)
