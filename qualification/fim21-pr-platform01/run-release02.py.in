 result['release_paths_present']={n:(T/n).exists() for n in ('bin/afu_synth','bin/update_pim','hw/lib/build/quartus_proj_dir','hw/lib/build/platform/ofs_plat_if','hw/blue_bits/ofs_top.sof','hw/lib/fme-ifc-id.txt')}
 result['success']=result['complete'] and 'error' not in result and len(result['commands'])==2 and all(e.get('effective_rc')==0 for e in result['commands']) and not result['diagnostics'] and all(result['release_paths_present'].values()) and not result['postflight_errors'] and all(result.get(k) is True for k in ('original_work21_unchanged','pim_unchanged','tools_unchanged','base_images_unchanged'))
 result['ended']=datetime.now(timezone.utc).isoformat();persist()
 blob=gzip.compress(json.dumps(result,sort_keys=True).encode(),mtime=0);(R/'result.json.gz').write_bytes(blob)
 subprocess.run(['tmux','load-buffer','-b','ia840f_pr_export02','-'],input=blob,check=True);subprocess.run(['tmux','set-buffer','-b','ia840f_pr_export02_sha256',hashlib.sha256(blob).hexdigest()],check=True)
