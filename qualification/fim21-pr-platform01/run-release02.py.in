def digest(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def bound(root,entries):
 for n,e in entries.items():
  p=root/n
  if e.get('kind')=='symlink':assert p.is_symlink() and os.readlink(p)==e['target'],str(p)
  else:assert p.is_file() and not p.is_symlink() and p.stat().st_size==e['bytes'] and digest(p)==e['sha256'],str(p)
 return True
