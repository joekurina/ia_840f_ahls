def change(p,b,reason):
 old=p.read_bytes();assert old!=b;rel=str(p.relative_to(D));delta[rel]={'before':hashlib.sha256(old).hexdigest(),'after':hashlib.sha256(b).hexdigest(),'before_bytes':len(old),'after_bytes':len(b),'reason':reason};p.write_bytes(b);assert digest(p)==delta[rel]['after']
# Only source-location attributes in copied generated XML; no RTL/parameter edits.
