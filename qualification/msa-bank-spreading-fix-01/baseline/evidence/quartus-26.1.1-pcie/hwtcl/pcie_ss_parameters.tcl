                        ip_set_param "parameter.core4_1_dfl_next_cap_offset_hwtcl.value" 0
                        for {set i 1} { $i < 1 } {incr i} {
                            set core4_1_virtual_pfi_enable_hwtcl [ip_get "parameter.core4_1_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core4_0_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            } else {
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                    } else {
                        ip_set_param "parameter.core4_1_user_vsec_cap_enable_hwtcl.value" 1
                        ip_set_param "parameter.core4_1_vsec_next_offset_hwtcl.value" $core4_1_ceb_pf_ext_cap_last_ptr_hwtcl
                        ip_set_param "parameter.core4_1_dfl_next_cap_offset_hwtcl.value" 0
                       set tile [ip_get "parameter.TILE.value"]
                       if {$tile =="P-TILE" ||$tile =="F-TILE"} {  
                        for {set i 1} { $i < 1 } {incr i} {
                            set core4_1_virtual_pfi_enable_hwtcl [ip_get "parameter.core4_1_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core4_1_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core4_1_ceb_pf_ext_cap_last_ptr_hwtcl
                                } else {
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                      } else {
                         for {set i 0} { $i < 1 } {incr i} {
                            set core4_1_virtual_pfi_enable_hwtcl [ip_get "parameter.core4_1_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core4_1_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core4_1_ceb_pf_ext_cap_last_ptr_hwtcl
                                } else {
                                ip_set_param "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }

                      }
                    }
                }
            }
 
                    
            set_qhip_param "core4_1_user_vsec_cap_enable_hwtcl" [ip_get "parameter.core4_1_user_vsec_cap_enable_hwtcl.value"]
            set_qhip_param "core4_1_vsec_next_offset_hwtcl" [ip_get "parameter.core4_1_vsec_next_offset_hwtcl.value"]
            for {set i 1} { $i < 1 } {incr i} {
                set_qhip_param "core4_1_virtual_pf${i}_user_vsec_offset_hwtcl" [ip_get "parameter.core4_1_virtual_pf${i}_user_vsec_offset_hwtcl.value"]
            }
            if {$core4_1_enable_dfl && ($core4_1_enable_ceb_ss ==0 && $core4_1_enable_cii==0)} {
               ip_message error "Enable PCIe3 Configuration Extension Bus Interface needs to be selected if Enable PCIe3 DFL VSEC Capability is selected"
            }                
        }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_dfh_hwtcl { PROP_NAME PROP_VALUE } {

        if {[regexp "core16" $PROP_NAME]} {
            set core "core16"
            set interface "p0_lite_csr"
        } elseif {[regexp "core8" $PROP_NAME]} {
            set core "core8"
            set interface "p1_lite_csr"
        } elseif {[regexp "core4_0" $PROP_NAME]} {
            set core "core4_0"
            set interface "p2_lite_csr"
        } else {
            set core "core4_1"
            set interface "p3_lite_csr"
        }

        set feature_id       [ip_get "parameter.${core}_dfh_fid_hwtcl.value"]
        set major_version    [ip_get "parameter.${core}_dfh_major_ver_hwtcl.value"]
        set next_byte_offset [ip_get "parameter.${core}_dfh_next_byte_offset_hwtcl.value"]
        set end              [ip_get "parameter.${core}_dfh_end_hwtcl.value"]
        set minor_revision   [ip_get "parameter.${core}_dfh_minor_rev_hwtcl.value"]
        set version          [ip_get "parameter.${core}_dfh_ver_hwtcl.value"]
        set feature_type     [ip_get "parameter.${core}_dfh_feature_type_hwtcl.value"]
        set inst_id          [ip_get "parameter.${core}_inst_id_hwtcl.value"]


        if { [get_quartus_ini "pd_enable_dfl_builder" ENABLED] } {
            set_interface_property $interface DFH_FEATURE_GUID              0xb563_2d823368_4a289fc4_21cddf63_cd30
            # Commented DFH_FEATURE_TYPE as this parameter is not available yet
            #set_interface_property $interface DFH_FEATURE_TYPE              $feature_type
            set_interface_property $interface DFH_FEATURE_MINOR_VERSION     $minor_revision
            set_interface_property $interface DFH_FEATURE_MAJOR_VERSION     $major_version
            set_interface_property $interface DFH_FEATURE_ID                $feature_id
            set_interface_property $interface DFH_GROUP_ID                  0
        }


    }
  
    proc ::intel_pcie_ss_axi::parameters::validate_cii_en_hwtcl { PROP_NAME PROP_VALUE } {
    set tile [ip_get "parameter.TILE.value"]
    if {$tile == "P-TILE" ||$tile =="R-TILE"} {
        set topology [ip_get "parameter.top_topology_hwtcl.value"]
    	set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]
        set virtual_rp_ep_mode_value [ip_get "parameter.virtual_rp_ep_mode_hwtcl.value"]
        set ss_core16_ceb_en [ip_get "parameter.core16_ceb_en_hwtcl.value"]
        set ss_core8_ceb_en [ip_get "parameter.core8_ceb_en_hwtcl.value"]
        set ss_core4_0_ceb_en [ip_get "parameter.core4_0_ceb_en_hwtcl.value"]
        set ss_core4_1_ceb_en [ip_get "parameter.core4_1_ceb_en_hwtcl.value"]
        set core16_enable_dfl [ip_get "parameter.core16_dfl_en_hwtcl.value"]
        set core8_enable_dfl  [ip_get "parameter.core8_dfl_en_hwtcl.value"] 
        set core4_0_enable_dfl [ip_get "parameter.core4_0_dfl_en_hwtcl.value"]
        set core4_1_enable_dfl  [ip_get "parameter.core4_1_dfl_en_hwtcl.value"] 
        set core16_ceb_en [ip_get "parameter.core16_ceb_enable_hwtcl.value"]
        set core8_ceb_en [ip_get "parameter.core8_ceb_enable_hwtcl.value"]
        
        if { $PROP_VALUE } {
    	    if {[regexp "Data Mover" $pcie_ss_func_mode_value] || ![regexp "Native Endpoint" $virtual_rp_ep_mode_value]} {
    			send_message error  "PCIe Subsystem CII is applicable only when operating as Endpoint in Power User Mode."
    		}
            if {($ss_core16_ceb_en || $core16_enable_dfl) && [regexp "core16" $PROP_NAME]} {
                send_message error  "The Port 0 CII interface is mutually exclusive with Port 0 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            }
            if {($ss_core8_ceb_en || $core8_enable_dfl) && [regexp "core8" $PROP_NAME]} {
                send_message error  "The Port 1 CII interface is mutually exclusive with Port 1 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            } 
            if {($core16_ceb_en || $core16_enable_dfl)  && [regexp "core16" $PROP_NAME]} {
                send_message error  "The CII interface is mutually exclusive with CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time. \
                                     Please disable the CEB at Port 0"
            }
            if {($core8_ceb_en || $core8_enable_dfl) && [regexp "core8" $PROP_NAME]} {
                send_message error  "The CII interface is mutually exclusive with CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time. \
                                     Please disable the CEB at Port 1"
            }
            if {($ss_core4_0_ceb_en ||$core4_0_enable_dfl)  && [regexp "core4_0" $PROP_NAME]} {
                send_message error  "The CII interface is mutually exclusive with CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time. \
                                     Please disable the CEB at Port 2"
            }
            if {($ss_core4_1_ceb_en||$core4_1_enable_dfl) && [regexp "core4_1" $PROP_NAME]} {
                send_message error  "The CII interface is mutually exclusive with CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time. \
                                     Please disable the CEB at Port 3"
            }

                
        }
    } elseif {$tile == "F-TILE"} {
    	set topology [ip_get "parameter.top_topology_hwtcl.value"]
    	set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]
        set virtual_rp_ep_mode_value [ip_get "parameter.virtual_rp_ep_mode_hwtcl.value"]
        set ss_core16_ceb_en [ip_get "parameter.core16_ceb_en_hwtcl.value"]
        set ss_core8_ceb_en [ip_get "parameter.core8_ceb_en_hwtcl.value"]
        set ss_core4_0_ceb_en [ip_get "parameter.core4_0_ceb_en_hwtcl.value"]
        set ss_core4_1_ceb_en [ip_get "parameter.core4_1_ceb_en_hwtcl.value"]
        set core16_enable_dfl [ip_get "parameter.core16_dfl_en_hwtcl.value"]
        set core8_enable_dfl  [ip_get "parameter.core8_dfl_en_hwtcl.value"]   
        set core4_0_enable_dfl [ip_get "parameter.core4_0_dfl_en_hwtcl.value"]
        set core4_1_enable_dfl  [ip_get "parameter.core4_1_dfl_en_hwtcl.value"]

        if { $PROP_VALUE } {
    	    if {[regexp "Data Mover" $pcie_ss_func_mode_value] || ![regexp "Native Endpoint" $virtual_rp_ep_mode_value]} {
    			send_message error  "PCIe Subsystem CII is applicable only when operating as Endpoint in Power User Mode."
    		}
            if {($ss_core16_ceb_en || $core16_enable_dfl) && [regexp "core16" $PROP_NAME]} {
                send_message error  "The Port 0 CII interface is mutually exclusive with Port 0 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            }
            if {($ss_core8_ceb_en || $core8_enable_dfl) && [regexp "core8" $PROP_NAME]} {
                send_message error  "The Port 1 CII interface is mutually exclusive with Port 1 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            }  
            if {($ss_core4_0_ceb_en || $core4_0_enable_dfl) && [regexp "core4_0" $PROP_NAME]} {
                send_message error  "The Port 2 CII interface is mutually exclusive with Port 2 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            } 
            if {($ss_core4_1_ceb_en || $core4_1_enable_dfl) && [regexp "core4_1" $PROP_NAME]} {
                send_message error  "The Port 3 CII interface is mutually exclusive with Port 3 CEB interface and DFL feature in PCIe Subsystem. Hence, both cannot be enabled at the same time."
            } 
      }
        set topology_core16    [ip_get "parameter.top_topology_hwtcl.value"]
        if { [regexp "1x4" $topology_core16] } {
           ip_set_param "parameter.core16_cii_en_hwtcl.VISIBLE" false
           }
 
    }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_virtio_pci_cfg_acc_intf_en_hwtcl { PROP_NAME PROP_VALUE } {         
        set core16_virtio_en   [ip_get "parameter.core16_enable_virtio_hwtcl.value"]
        set core8_virtio_en    [ip_get "parameter.core8_enable_virtio_hwtcl.value"]
        set core4_0_virtio_en  [ip_get "parameter.core4_0_enable_virtio_hwtcl.value"]
        set core4_1_virtio_en  [ip_get "parameter.core4_1_enable_virtio_hwtcl.value"]
        set tile               [ip_get "parameter.TILE.value"]
        set topology           [ip_get "parameter.top_topology_hwtcl.value"]
        if {$tile == "F-TILE"} {
 
            if { [regexp "1x4" $topology] } {
                  ip_set_param "parameter.core16_virtio_pci_cfg_acc_intf_en_hwtcl.VISIBLE" false
                  }
        }
 
            if { $PROP_VALUE } {
                if {[regexp "core16" $PROP_NAME]} {
                    if { !$core16_virtio_en } {
                            send_message error  "Enable PCIe0 Virtio PCI CFG Interface is not supported when VIRTIO support in Port 0 is disabled."
                    }
                }
                if {[regexp "core8" $PROP_NAME]} {
                    if { !$core8_virtio_en } {
                            send_message error  "Enable PCIe1 Virtio PCI CFG Interface is not supported when VIRTIO support in Port 1 is disabled."
                    }
                }
                if {[regexp "core4_0" $PROP_NAME]} {
                    if { !$core4_0_virtio_en } {
                            send_message error  "Enable PCIe2 Virtio PCI CFG Interface is not supported when VIRTIO support in Port 2 is disabled."
                    }
                }
                if {[regexp "core4_1" $PROP_NAME]} {
                    if { !$core4_1_virtio_en } {
                            send_message error  "Enable PCIe3 Virtio PCI CFG Interface is not supported when VIRTIO support in Port 3 is disabled."
                    }
                }
 
            }
    }
    
    proc ::intel_pcie_ss_axi::parameters::validate_true_independent_support_mode_hwtcl {TILE virtual_rp_ep_mode_hwtcl top_topology_hwtcl silicon_revc_fm41_hwtcl true_independent_support_mode_user_hwtcl} {
        if {$TILE == "R-TILE" && $silicon_revc_fm41_hwtcl == 1 && [regexp "2x8" $top_topology_hwtcl]} {
            ip_set_param "parameter.true_independent_support_mode_user_hwtcl.VISIBLE" true
            ip_set_param "parameter.true_independent_support_mode_user_hwtcl.ENABLED" true
            if {$true_independent_support_mode_user_hwtcl} {
                ip_set_param "parameter.independent_perst_int_hwtcl.value" 1 
                ip_set_param "parameter.true_independent_support_mode_hwtcl.value" 1
                set_qhip_param "true_independent_support_mode_user_hwtcl" [ip_get "parameter.true_independent_support_mode_user_hwtcl.value"]
                set_qhip_param "hssi_ctr_true_independent_support_mode" enable
            } else {
                ip_set_param "parameter.independent_perst_int_hwtcl.value" 0
                ip_set_param "parameter.true_independent_support_mode_hwtcl.value" 0
                set_qhip_param "true_independent_support_mode_user_hwtcl" [ip_get "parameter.true_independent_support_mode_user_hwtcl.value"]
                set_qhip_param "hssi_ctr_true_independent_support_mode" disable
            }
        } elseif {$TILE == "R-TILE"} {
            ip_set_param "parameter.true_independent_support_mode_user_hwtcl.VISIBLE" false
            ip_set_param "parameter.true_independent_support_mode_user_hwtcl.ENABLED" false
            ip_set_param "parameter.independent_perst_int_hwtcl.value" 0
            ip_set_param "parameter.true_independent_support_mode_hwtcl.value" 0
            set_qhip_param "true_independent_support_mode_user_hwtcl" 0
            set_qhip_param "hssi_ctr_true_independent_support_mode" disable
        }
    }
