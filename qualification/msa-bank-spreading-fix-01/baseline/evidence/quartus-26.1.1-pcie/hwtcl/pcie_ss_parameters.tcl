			set_qhip_param "core16_virtual_tlp_bypass_en_hwtcl" 0
			set_qhip_param "core8_virtual_tlp_bypass_en_hwtcl" 1
			set_qhip_param "core4_0_virtual_tlp_bypass_en_hwtcl" 0
			set_qhip_param "core4_1_virtual_tlp_bypass_en_hwtcl" 0
            
        	} elseif { $virtual_rp_ep_mode_hwtcl == "Upstream / Endpoint" } {
        		# 2x8 up/ep
        		ip_set_param "parameter.$PROP_NAME.value" "Bypass_Mix"
