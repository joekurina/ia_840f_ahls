   proc ::intel_pcie_ss_axi::parameters::validate_pld_clkfreq_hwtcl { PROP_NAME PROP_VALUE top_topology_hwtcl hssi_ctr_pcie_pld_data_width_hwtcl} {
    set tile [ip_get "parameter.TILE.value"]
    set core16_hip_native        [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
    set core8_hip_native         [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
    set core4_0_hip_native       [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
    set core4_1_hip_native       [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
    
     
    if {$tile == "P-TILE"} {
	#default pld_clock
	set pld_clkfreq_hwtcl   "400MHz"
    set device  			[ip_get "parameter.device.value"]
	set d_family 			[ip_get "parameter.device_family.value"]
    set mcdma_enabled 		[ip_get "parameter.mcdma_enabled_hwtcl.value" ]
    set adapter_type		[ip_get "parameter.adapter_type_hwtcl.value"]
    
    set_qhip_param "device_family" $d_family
    set_qhip_param "base_device" $d_family	
    if { [regexp "Gen5" $top_topology_hwtcl] } {
       		ip_set_param "parameter.g5_pld_clkfreq_user_hwtcl.VISIBLE" true
			set pld_clkfreq_hwtcl [ip_get "parameter.g5_pld_clkfreq_user_hwtcl.value"]
	}

	if { [regexp "Gen4" $top_topology_hwtcl] } {
        #Gen4 2x8 512 bit and Gen4 4x4 256 bit are not supported 
		#	ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.VISIBLE" true
		#	ip_set_param "parameter.g3_pld_clkfreq_user_hwtcl.VISIBLE" false		
		#if { [regexp "Gen4x8, Interface - 512 bit" $top_topology_hwtcl] ||  [regexp "Gen4x4, Interface - 256 bit" $top_topology_hwtcl]} {
		#  if { [ip_get "parameter.device_family.value"] eq "Stratix 10" } {
		#  	  set pld_clkfreq_hwtcl "400MHz"			
		#  } else {
		#  	  set pld_clkfreq_hwtcl "500MHz"			
		#  }
		#} else {
			ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.VISIBLE" true
			ip_set_param "parameter.g3_pld_clkfreq_user_hwtcl.VISIBLE" false
			set pld_clkfreq_hwtcl [ip_get "parameter.g4_pld_clkfreq_user_hwtcl.value"]
			set avmm_enabled [ip_get "parameter.avmm_enabled_hwtcl.value"]
			if { $avmm_enabled == 0 || $mcdma_enabled == 1} {
                # limit Stratix 10 max pld_clock to 400MHz
                if { [ip_get "parameter.device_family.value"] eq "Stratix 10" } {
                    #ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"450MHz" "400MHz" "350MHz" "250MHz" "225MHz" "200MHz" "175MHz"}
                    ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"450MHz" "400MHz" "350MHz"}
                    if { $pld_clkfreq_hwtcl == "500MHz" } {
                        set pld_clkfreq_hwtcl "400MHz"
                    }
                } else {
                    #ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"500MHz" "450MHz" "400MHz" "350MHz" "250MHz" "225MHz" "200MHz" "175MHz"}
                    ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"500MHz" "450MHz" "400MHz" "350MHz" "300MHz"}
                }
			} else {
				# Limit Stratix 10 max pld_clk to 350Mhz
				if { [ip_get "parameter.device_family.value"] eq "Stratix 10" } {
                    if { [regexp "Gen4 1x16" $top_topology_hwtcl] } {
                        ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"350MHz"}
                        if { $pld_clkfreq_hwtcl != "350MHz" } {
                            set pld_clkfreq_hwtcl "350MHz"
                        }
                    } else {
                        ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"400MHz" "350MHz"}
                        if { $pld_clkfreq_hwtcl == "500MHz" } {
                            set pld_clkfreq_hwtcl "400MHz"
                        }                        
                    }
				} else {
                    # Limit Agilex Max pld_clk to 400Mhz for G4x16
                    if { [regexp "Gen4 1x16" $top_topology_hwtcl] } {
                        ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"400MHz" "350MHz"}
                        if { $pld_clkfreq_hwtcl == "500MHz" } {
                            set pld_clkfreq_hwtcl "400MHz"
                        }                        
                    } else {  
                        ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.allowed_ranges" {"500MHz" "400MHz" "350MHz"}
                    } 
				}
			}
		#} #end of gen4 2x8 512 bit and gen4 4x4 256 bit 
		set g4_pld_clkfreq_user_hwtcl [ip_get "parameter.g4_pld_clkfreq_user_hwtcl.value"]
		set_qhip_param "g4_pld_clkfreq_user_hwtcl" $g4_pld_clkfreq_user_hwtcl

        if {[regexp "Gen4 1x16" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false         
        }
        if {[regexp "Gen4 2x8" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false
        }
        if {[regexp "Gen4 1x8" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false
        } 
        if {[regexp "Gen4 4x4" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false        
        }
        if {[regexp "Gen4 1x4" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false        
        }
        if {[regexp "Gen4 2x4" $top_topology_hwtcl]} {
               ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ENABLED" false        
