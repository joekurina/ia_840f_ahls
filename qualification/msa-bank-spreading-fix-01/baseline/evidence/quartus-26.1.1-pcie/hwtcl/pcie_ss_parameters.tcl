   proc ::intel_pcie_ss_axi::parameters::validate_ss_axist_dps { PROP_NAME PROP_VALUE } {
        set core16_hip_native   [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
        set core8_hip_native    [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
        set core4_0_hip_native  [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
        set core4_1_hip_native  [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
        set core16_header_scheme_hwtcl    [ip_get "parameter.core16_header_scheme_hwtcl.value"]
        set core8_header_scheme_hwtcl     [ip_get "parameter.core16_header_scheme_hwtcl.value"]
        set core4_0_header_scheme_hwtcl   [ip_get "parameter.core16_header_scheme_hwtcl.value"]
        set core4_1_header_scheme_hwtcl   [ip_get "parameter.core16_header_scheme_hwtcl.value"]
        set core16_hip   [ip_get "parameter.core16_hip_native_mode_hwtcl.value"]
        set core8_hip    [ip_get "parameter.core8_hip_native_mode_hwtcl.value"]
        set core4_0_hip  [ip_get "parameter.core4_0_hip_native_mode_hwtcl.value"]
        set core4_1_hip  [ip_get "parameter.core4_1_hip_native_mode_hwtcl.value"]

        set tile [ip_get "parameter.TILE.value"]
        
      if {$tile =="R-TILE"} {
        if {$core16_hip_native==1 &&$core16_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core16_Header_Packing_scheme.value"  "HIP-NATIVE"
        } else {
              ip_set_param "parameter.core16_Header_Packing_scheme.value"  "Compact"
        }
        if {$core8_hip_native==1 &&$core8_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core8_Header_Packing_scheme.value"  "HIP-NATIVE"
        } else {
              ip_set_param "parameter.core8_Header_Packing_scheme.value"  "Compact"
        }
        if {$core4_0_hip_native==1 &&$core4_0_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core4_0_Header_Packing_scheme.value"  "HIP-NATIVE"
        } else {
              ip_set_param "parameter.core4_0_Header_Packing_scheme.value"  "Compact"
        }
        if {$core4_1_hip_native==1 &&$core4_1_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core4_1_Header_Packing_scheme.value"  "HIP-NATIVE"
        } else {
              ip_set_param "parameter.core4_1_Header_Packing_scheme.value"  "Compact"
        }
     } else {
       if {$core16_hip==0 &&$core16_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core16_Header_Packing_scheme.value"  "Compact"
       }
       if {$core8_hip==0 &&$core8_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core8_Header_Packing_scheme.value"  "Compact"
       }
       if {$core4_0_hip==0 &&$core4_0_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core4_0_Header_Packing_scheme.value"  "Compact"
       }
       if {$core4_1_hip==0 &&$core4_1_header_scheme_hwtcl =="SIDE-BAND" } {
              ip_set_param "parameter.core4_1_Header_Packing_scheme.value"  "Compact"
       }     
     }    

   }

     proc ::intel_pcie_ss_axi::parameters::validate_segment_size_hwtcl { PROP_NAME PROP_VALUE core16_dwidth_byte_hwtcl core8_dwidth_byte_hwtcl core4_0_dwidth_byte_hwtcl core4_1_dwidth_byte_hwtcl core16_num_seg_hwtcl core8_num_seg_hwtcl core4_0_num_seg_hwtcl core4_1_num_seg_hwtcl } {
      set tile [ip_get "parameter.TILE.value"]
        set core16_hip_native   [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
        set core8_hip_native    [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
        set core4_0_hip_native  [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
        set core4_1_hip_native  [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
        set topology [ip_get "parameter.top_topology_hwtcl.value"]
        if {$core16_hip_native ==1} {
          if {$topology =="Gen5 1x16" ||$topology =="Gen5 2x8" ||$topology =="Gen5 1x8"||$topology =="Gen4 1x16" ||$topology =="Gen4 1x8" ||$topology =="Gen3 1x8"||$topology=="Gen4 2x8" ||$topology=="Gen3 1x16" ||$topology =="Gen3 2x8" } {
           ip_set_param "parameter.core16_segment_size_hwtcl.value" 32
          } elseif {$topology =="Gen5 4x4"||$topology =="Gen4 4x4" ||$topology =="Gen3 4x4"||$topology =="Gen4 1x4" ||$topology =="Gen3 1x4" ||$topology=="Gen4 2x4" ||$topology=="Gen3 2x4"} {
           ip_set_param "parameter.core16_segment_size_hwtcl.value" 16
          }
        } else {
             ip_set_param "parameter.core16_segment_size_hwtcl.value"   [expr $core16_dwidth_byte_hwtcl/$core16_num_seg_hwtcl]
           }
        if {$core8_hip_native ==1} {
          if {$topology =="Gen5 1x16" ||$topology =="Gen5 2x8" ||$topology =="Gen4 1x16" ||$topology=="Gen4 2x8" ||$topology=="Gen3 1x16"||$topology =="Gen3 2x8" } {           
           ip_set_param "parameter.core8_segment_size_hwtcl.value" 32
           } elseif {$topology =="Gen5 4x4"||$topology =="Gen4 4x4" ||$topology =="Gen3 4x4"||$topology =="Gen4 1x4" ||$topology =="Gen3 1x4" ||$topology=="Gen4 2x4" ||$topology=="Gen3 2x4"} {
           ip_set_param "parameter.core8_segment_size_hwtcl.value" 16
          }
        } else {
             ip_set_param "parameter.core8_segment_size_hwtcl.value"   [expr $core8_dwidth_byte_hwtcl/$core8_num_seg_hwtcl]
        }
       if {$core4_0_hip_native ==1} {
          if {$topology =="Gen5 1x16" ||$topology =="Gen5 2x8" ||$topology =="Gen4 1x16" ||$topology=="Gen4 2x8" ||$topology=="Gen3 1x16"||$topology =="Gen3 2x8" } {                      
           ip_set_param "parameter.core4_0_segment_size_hwtcl.value" 32
          } elseif {$topology =="Gen5 4x4"||$topology =="Gen4 4x4" ||$topology =="Gen3 4x4"} {
           ip_set_param "parameter.core4_0_segment_size_hwtcl.value" 16
         }
        } else {
             ip_set_param "parameter.core4_0_segment_size_hwtcl.value"   [expr $core4_0_dwidth_byte_hwtcl/$core4_0_num_seg_hwtcl]
        }
       if {$core4_1_hip_native ==1} {
          if {$topology =="Gen5 1x16" ||$topology =="Gen5 2x8" ||$topology =="Gen4 1x16" ||$topology=="Gen4 2x8" ||$topology=="Gen3 1x16"||$topology =="Gen3 2x8" } {                                
           ip_set_param "parameter.core4_1_segment_size_hwtcl.value" 32
          } elseif {$topology =="Gen5 4x4"||$topology =="Gen4 4x4" ||$topology =="Gen3 4x4"} {
           ip_set_param "parameter.core4_1_segment_size_hwtcl.value" 16
          }
        } else {
             ip_set_param "parameter.core4_1_segment_size_hwtcl.value"   [expr $core4_1_dwidth_byte_hwtcl/$core4_1_num_seg_hwtcl]
        }
        
        if {$tile =="P-TILE" ||$tile =="F-TILE"} {
             ip_set_param "parameter.core16_segment_size_hwtcl.value"   [expr $core16_dwidth_byte_hwtcl/$core16_num_seg_hwtcl]
             ip_set_param "parameter.core8_segment_size_hwtcl.value"   [expr $core8_dwidth_byte_hwtcl/$core8_num_seg_hwtcl]
             ip_set_param "parameter.core4_0_segment_size_hwtcl.value"   [expr $core4_0_dwidth_byte_hwtcl/$core4_0_num_seg_hwtcl]
             ip_set_param "parameter.core4_1_segment_size_hwtcl.value"   [expr $core4_1_dwidth_byte_hwtcl/$core4_1_num_seg_hwtcl]
       }      

    }  	  
   
  
