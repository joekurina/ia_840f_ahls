    proc ::intel_pcie_ss_axi::parameters::validate_total_core_num_hwtcl { PROP_VALUE PROP_NAME top_topology_hwtcl } {
	if { [regexp "2x8" $top_topology_hwtcl] } {
		ip_set_param "parameter.$PROP_NAME.allowed_ranges" {1:2}
		ip_set_param "parameter.$PROP_NAME.value" 2
    } elseif { [regexp "1x8" $top_topology_hwtcl] } {
		ip_set_param "parameter.$PROP_NAME.allowed_ranges" {1:2}
		ip_set_param "parameter.$PROP_NAME.value" 1
	} elseif { [regexp "4x4" $top_topology_hwtcl] } {
    		ip_set_param "parameter.$PROP_NAME.allowed_ranges" {1:4}
    		ip_set_param "parameter.$PROP_NAME.value" 4
    } elseif { [regexp "2x4" $top_topology_hwtcl] } {
    		ip_set_param "parameter.$PROP_NAME.allowed_ranges" {1:4}
    		ip_set_param "parameter.$PROP_NAME.value" 2
    } elseif { [regexp "1x4" $top_topology_hwtcl] } {
    		ip_set_param "parameter.$PROP_NAME.allowed_ranges" {1:4}
    		ip_set_param "parameter.$PROP_NAME.value" 1

    	} else {
    		ip_set_param "parameter.$PROP_NAME.value" 1
    	}
    }    

