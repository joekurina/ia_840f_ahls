        		set_qhip_param "core8_virtual_tlp_bypass_en_hwtcl" 1
        		set_qhip_param "core4_0_virtual_tlp_bypass_en_hwtcl" 1
        		set_qhip_param "core4_1_virtual_tlp_bypass_en_hwtcl" 1
        	}
        }
 
