  proc ::intel_pcie_ss_axi::parameters::validate_axi_st_clk_freq { PROP_NAME PROP_VALUE} {
    set core16_hip_native        [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
    set core8_hip_native         [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
    set core4_0_hip_native       [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
    set core4_1_hip_native       [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
    set tile [ip_get "parameter.TILE.value"]
    set topology   [ip_get "parameter.top_topology_hwtcl.value"]
    if {$tile =="R-TILE"} {
        if {$topology =="Gen5 1x16" ||$topology =="Gen4 1x16" ||$topology =="Gen5 1x8" ||$topology =="Gen4 1x8" ||$topology =="Gen4 1x4" ||$topology =="Gen3 1x4" ||$topology =="Gen3 1x16" ||$topology =="Gen3 1x8"} {
            if {$core16_hip_native ==1} {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" false
            } else {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" true
            }
        }
        if {$topology =="Gen5 2x8"||$topology =="Gen4 2x8"||$topology =="Gen4 2x4"||$topology =="Gen3 2x8"||$topology =="Gen3 2x4"} {
            if {$core16_hip_native ==1 &&$core8_hip_native==1} {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" false              
              ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.ENABLED" false
            } else {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" true              
              ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.ENABLED" true
            }
        }
        if {$topology =="Gen5 4x4" ||$topology =="Gen4 4x4" ||$topology =="Gen3 4x4"} {
             if {$core16_hip_native ==1 &&$core8_hip_native==1 &&$core4_0_hip_native==1 &&$core4_1_hip_native ==1} {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" false
              ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.ENABLED" false
              ip_set_param "parameter.core4_0_axi_st_clk_freq_user_hwtcl.ENABLED" false
              ip_set_param "parameter.core4_1_axi_st_clk_freq_user_hwtcl.ENABLED" false
