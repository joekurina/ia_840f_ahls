    proc ::intel_pcie_ss_axi::parameters::set_m_ignore_parameters {} {
        #puts "JOHNNY GUI PERF DEBUG: set mignore"
        set ip_topology [ip_get "parameter.top_topology_hwtcl.value"]
        set core16_total_pf_count_hwtcl [ip_get "parameter.core16_total_pf_count_hwtcl.value"]
        set core8_total_pf_count_hwtcl [ip_get "parameter.core8_total_pf_count_hwtcl.value"]

        # Pf VF counts
        set core16_enable_sriov_hwtcl [ip_get "parameter.core16_enable_sriov_hwtcl.value"]
        set core8_enable_sriov_hwtcl [ip_get "parameter.core8_enable_sriov_hwtcl.value"]

        set disable_x8 0
        set disable_x4 0
        if { [regexp "x16" $ip_topology] || [regexp "1x8" $ip_topology]} {        
            set disable_x8 1
            set disable_x4 1
        } elseif {[regexp "2x8" $ip_topology]} {
            set disable_x4 1
        }

        set GUI_parameters [ip_get_matching_parameters [dict set criteria M_IP_CORE "NOVAL" ]]
        foreach parameter $GUI_parameters {
            if {[string first "core16" $parameter] != -1} {
                set pf_match [regexp {pf(.)_} $parameter match pf_num]
                if {$pf_match} {
                    if {$pf_num >= $core16_total_pf_count_hwtcl} {
                        ip_set "parameter.${parameter}.M_IGNORE" 1
                        set_parameter_property ${parameter} "VISIBLE" false
                    } else {
                        if { [string first "vf" $parameter] != -1 && $core16_enable_sriov_hwtcl == 0 } {
                            ip_set "parameter.${parameter}.M_IGNORE" 1
                            set_parameter_property ${parameter} "VISIBLE" false
                        } else {
                            ip_set "parameter.${parameter}.M_IGNORE" 0
                        }
                    }
                } else {
                    ip_set "parameter.${parameter}.M_IGNORE" 0
                }
            } elseif { [string first "core8" $parameter] != -1} {
                if {$disable_x8} {
                    ip_set "parameter.${parameter}.M_IGNORE" 1
                    set_parameter_property ${parameter} "VISIBLE" false
                } else {
                    set pf_match [regexp {pf(.)_} $parameter match pf_num]
                    if {$pf_match} {
                        if {$pf_num >= $core8_total_pf_count_hwtcl} {
                            ip_set "parameter.${parameter}.M_IGNORE" 1
                            set_parameter_property ${parameter} "VISIBLE" false
                        } else {
                            if { [string first "vf" $parameter] != -1 && $core8_enable_sriov_hwtcl == 0 } {
                                ip_set "parameter.${parameter}.M_IGNORE" 1
                                set_parameter_property ${parameter} "VISIBLE" false
                            } else {
                                ip_set "parameter.${parameter}.M_IGNORE" 0
                            }
                        }
                    } else {
                        ip_set "parameter.${parameter}.M_IGNORE" 0
                    }
                }
            } elseif { [string first "core4" $parameter] != -1} {
                if {$disable_x4} {
                    ip_set "parameter.${parameter}.M_IGNORE" 1
                    set_parameter_property ${parameter} "VISIBLE" false
                } else {
                    ip_set "parameter.${parameter}.M_IGNORE" 0
                }
            } 
        }
	ip_set "parameter.core16_payload_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core8_payload_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core4_0_payload_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core4_1_payload_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core16_empty_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core8_empty_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core4_0_empty_width_integer_hwtcl.M_IGNORE" 0
	ip_set "parameter.core4_1_empty_width_integer_hwtcl.M_IGNORE" 0

        # Need to run its validation callback to make sure it is set to zero in 1x16 topo
	ip_set "parameter.core8_pf0_pci_msix_table_size_user_hwtcl.M_IGNORE" 0         
    }
    
    proc ::intel_pcie_ss_axi::parameters::validate_device_revision { } {
    	set tile [ip_get "parameter.TILE.value"]
	set device_die_types [ip_get "parameter.device_die_types.value"]
	set device_die_revisions [ip_get "parameter.device_die_revisions.value"]
	set device [ip_get "parameter.device.value"]
	variable supported_die_types
	set temp_device_revision "NOVAL"
    
	if {$device_die_types == "Unknown"} {
		set device_die_types {MAIN_ND5 HSSI_WHR}
		set device_die_revisions {MAIN_ND5_REVB HSSI_WHR_REVA}
		ip_message warning "Parameter device_die_types and device_die_revisions are not passed down to the IP. Please update your IP to pass down the parameters for correct bit settings."
	}

    
    	#ww14 added tile selection based on opn device
	if {[s10_die_type_supported $device $device_die_types $supported_die_types]} {
		set die_pair [get_s10_die_pair $device $supported_die_types $device_die_types $device_die_revisions]
		if {$die_pair != -1} {

                        # Setting the TILE parameter value based on die pair
                        if {[regexp "WHR" $device_die_revisions]} {
                             ip_set_param "parameter.TILE.value" "P-TILE"
                             puts $device_die_revisions
                             puts [ip_get "parameter.TILE.value"]
                        } elseif {[regexp "GDR" $device_die_revisions] && ![regexp "RNR" $device_die_revisions] } {
                             ip_set_param "parameter.TILE.value" "F-TILE"
                             puts $device_die_revisions
                             puts [ip_get "parameter.TILE.value"]
                        } elseif {[regexp "RNR" $device_die_revisions] && ![regexp "GDR" $device_die_revisions]} {
                             ip_set_param "parameter.TILE.value" "R-TILE"
                             puts $device_die_revisions
                             puts [ip_get "parameter.TILE.value"]
                        } elseif {[regexp "RNR" $device_die_revisions] && [regexp "GDR" $device_die_revisions]} {
                             puts "GDR and RNR is found"
                             ip_set_param "parameter.TILE_user.ALLOWED_RANGES" {"F-TILE" "R-TILE"}
                             ip_set_param "parameter.TILE.value" [ip_get "parameter.TILE_user.value"]
                        } else {
                            ip_message warning "Wrong die pair!"
                        }
			
			if {$tile == "P-TILE"} {
				set temp_device_revision [::whr_xcvr_native::parameters::get_s10_device_revision $die_pair]
			} elseif {$tile == "F-TILE"} {
				set temp_device_revision [::gdr_xcvr_native::parameters::get_s10_device_revision $die_pair]
                        } elseif {$tile == "R-TILE"} {
				set temp_device_revision [::rnr_xcvr_native::parameters::get_s10_device_revision $die_pair]			

			}
		}
	}
    
	if {$temp_device_revision == "NOVAL"} {
		auto_message error device "The current selected device \"$device\" is invalid, please select a valid device to generate the IP."
	} else {
		#ip_message info "Debug : device=$device device_revision=$temp_device_revision"
		ip_set_param "parameter.device_revision.value" $temp_device_revision
	}
		# ip_message info "Debug : device=$device device_revision=$temp_device_revision"
		#ip_set_param "parameter.device_revision.value" "14nm4bwhra"
    
    }

    proc ::intel_pcie_ss_axi::parameters::s10_die_type_supported { device  device_die_types supported_die_types } {
	set legal 0
    
	set main_dies [lsearch -all -inline -regexp $supported_die_types {^MAIN.*}]
	foreach die_type $main_dies {
		if { [lsearch -regexp $device_die_types $die_type] != -1 } {
			set legal 1
			break
		}
        }
    
        if {$legal} {
        	set legal 0
        	set hssi_dies [lsearch -all -inline -regexp $supported_die_types {^HSSI.*}]
        	foreach die_type $hssi_dies {
        		if { [lsearch -regexp $device_die_types $die_type] != -1 } {
        			set legal 1
        			break
        		}
        	}
        }
    
        #puts "Debug: legal=$legal device=$device device_die_types=$device_die_types supported_die_types=$supported_die_types"
    	return $legal
    }

    proc ::intel_pcie_ss_axi::parameters::get_s10_die_pair { device supported_die_types device_die_types device_die_revisions } {
	set die_pair -1
    
	# Get main die
	set main_die_revision [lsearch -inline -regexp $device_die_revisions {^MAIN.*}]
    
	# Get HSSI die
	set hssi_dies [lsearch -all -inline -regexp $supported_die_types {^HSSI_.*}]
	foreach die $hssi_dies {
		set hssi_die_revision [lsearch -inline -regexp $device_die_revisions $die]
		if {$hssi_die_revision != ""} {
			break
		}
	}
    
	if {$main_die_revision != "" && $hssi_die_revision != ""} {
		set die_pair "${main_die_revision}_${hssi_die_revision}"
	}
    
	#puts "Debug : device=$device die_types=$device_die_types die_revisions=$device_die_revisions supported_die_types=$supported_die_types"
	return $die_pair
    }

    proc ::intel_pcie_ss_axi::parameters::validate_qhip_silicon_reva_revb_hwtcl { PROP_NAME PROP_VALUE device_revision} {

    	# Silicon Revision
    	if {$device_revision == "10nm6arnra"} {
    		#In FM6 (10nm6arnra): RNR device and MAIB is reva -> the directory is under //acds/main/quartus/icd_data/falconmesa/fm6
    		ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 0
    		ip_set_param "parameter.qhip_silicon_revc_hwtcl.value" 0
    	} elseif {$device_revision == "10nm8arnra" || $device_revision == "10nm8arnrb" || $device_revision == "10nm7arnrb"} {
    		#In FM8 (10nm8arnra): RNR device is reva but MAIB is revb -> the directory is under //acds/<branch>/quartus/icd_data/falconmesa/fm8reva/
    		#In FM8 (10nm8arnrb): RNR device is revb and MAIB is revb -> the directory is under //acds/<branch>/quartus/icd_data/falconmesa/fm8reva/
    		#In FM7 (10nm7arnrb): RNR device is revb and MAIB is revb -> the directory is under //acds/<branch>/quartus/icd_data/falconmesa/fm7
    		
    		if {$device_revision == "10nm8arnra"} { #reva
    			ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 0
    		} elseif {$device_revision == "10nm8arnrb" || $device_revision == "10nm7arnrb"} { #revb
    			ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 1
               
    		}
    		ip_set_param "parameter.qhip_silicon_revc_hwtcl.value" 0		
            
    	} else { 
    		#Expecting future RNR device using MAIB revb 
    		
    		if { [regexp "rnra" $device_revision] } { #reva
    			ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 0
    			ip_set_param "parameter.qhip_silicon_revc_hwtcl.value" 0
    		} elseif {[regexp "rnrb" $device_revision]} { #revb
    			ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 1
    			ip_set_param "parameter.qhip_silicon_revc_hwtcl.value" 0
    		} elseif {[regexp "rnrc" $device_revision]} { #revc same setting as revb
    			ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.value" 1 
    			ip_set_param "parameter.qhip_silicon_revc_hwtcl.value" 1
    		}
    		#To determine if the current OPN is running on FM41 RevC, for hiding p0/1_cold_perst
    		if {$device_revision == "10nm4arnrc"} { 
                ip_set_param "parameter.silicon_revc_fm41_hwtcl.value" 1
            } else {
                ip_set_param "parameter.silicon_revc_fm41_hwtcl.value" 0
            }
    	}
    }

