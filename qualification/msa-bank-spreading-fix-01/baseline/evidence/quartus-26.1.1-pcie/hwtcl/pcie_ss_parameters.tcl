    proc ::intel_pcie_ss_axi::parameters::validate {} {
        variable validated
        variable use_lampas_solver
        
        #To get device_revision
        validate_device_revision
        validate_qhip_device
        
        ::intel_pcie_ss_axi::parameters::set_m_ignore_parameters
        
        if { !$use_lampas_solver  } {
            ip_validate_parameters
        } else {
	    # set PROP_VALUE [ip_get "parameter.device_family.value"]
            ip_lampas_solver_setup 
            ip_validate_parameters_using_lampas_solver
        }
        ip_validate_display_items
        ::intel_pcie_ss_axi::parameters::validate_non_rbc_rules

        #From QHIP
        #set debug_features_enablement [get_quartus_ini "debug_features_enablement_full" ENABLED]
        #set core16_enable_virtio [ip_get "parameter.core16_enable_virtio_hwtcl.value"]
        #set core8_enable_virtio [ip_get "parameter.core8_enable_virtio_hwtcl.value"]

        #PCIE SS Validation on MSIX, Data Mover Mode Only
        set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]
        
        if {[regexp "Data Mover" $pcie_ss_func_mode_value]} {
            ::intel_pcie_ss_axi::parameters::validate_pciess_msix
            ::intel_pcie_ss_axi::parameters::validate_cpl_reordering
