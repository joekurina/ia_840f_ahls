    proc ::intel_pcie_ss_axi::parameters::validate_ss_axist_num_seg_user { PROP_NAME PROP_VALUE } {
    # Retrieve parameter values
    set core16_hip_native [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
    set core8_hip_native [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
    set core4_0_hip_native [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
    set core4_1_hip_native [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
    set topology [ip_get "parameter.top_topology_hwtcl.value"]
    set tile [ip_get "parameter.TILE.value"]
    set core16_dwidth_byte [ip_get "parameter.core16_dwidth_byte_user_hwtcl.value"]

    # Helper procedure to determine segment value
    proc determine_segment_value {native tile prop_value} {
        if {$native == 1 && $tile == "R-TILE"} {
            return 1
        } else {
            return $prop_value
        }
    }

    # Handle core16 configurations
    if {[regexp "core16" $PROP_NAME]} {
        if {$topology == "Gen5 1x16"} {
            if {$core16_hip_native == 0 && $tile == "R-TILE"} {
                if {$core16_dwidth_byte == 128} {
                    ip_set_param "parameter.core16_num_seg_user_hwtcl.allowed_ranges" {"1" "4"}
                } else {
                    ip_set_param "parameter.core16_num_seg_user_hwtcl.allowed_ranges" {"1" "2" "4"}
                }
            }
            ip_set_param "parameter.core16_num_seg_hwtcl.value" [determine_segment_value $core16_hip_native $tile $PROP_VALUE]
        } elseif {$topology in {"Gen4 1x16" "Gen3 1x16" "Gen5 2x8" "Gen5 1x8" "Gen4 2x8" "Gen4 1x8" "Gen3 2x8" "Gen3 1x8" "Gen4 2x4" "Gen3 2x4" "Gen4 1x4" "Gen3 1x4" "Gen5 4x4" "Gen4 4x4" "Gen3 4x4"}} {
            ip_set_param "parameter.core16_num_seg_hwtcl.value" [determine_segment_value $core16_hip_native $tile $PROP_VALUE]
        }
    }

    # Handle core8 configurations
    if {[regexp "core8" $PROP_NAME]} {
        if {$topology in {"Gen5 2x8" "Gen5 1x8" "Gen4 2x8" "Gen4 1x8" "Gen3 2x8" "Gen3 1x8" "Gen4 2x4" "Gen3 2x4" "Gen4 1x4" "Gen3 1x4" "Gen5 4x4" "Gen4 4x4" "Gen3 4x4"}} {
            ip_set_param "parameter.core8_num_seg_hwtcl.value" [determine_segment_value $core8_hip_native $tile $PROP_VALUE]
        }
    }

    # Handle core4_0 configurations
    if {[regexp "core4_0" $PROP_NAME]} {
        if {$topology in {"Gen5 4x4" "Gen4 4x4" "Gen3 4x4"}} {
            ip_set_param "parameter.core4_0_num_seg_hwtcl.value" [determine_segment_value $core4_0_hip_native $tile $PROP_VALUE]
        }
    }

    # Handle core4_1 configurations
    if {[regexp "core4_1" $PROP_NAME]} {
        if {$topology in {"Gen5 4x4" "Gen4 4x4" "Gen3 4x4"}} {
            ip_set_param "parameter.core4_1_num_seg_hwtcl.value" [determine_segment_value $core4_1_hip_native $tile $PROP_VALUE]
        }
    }
    }

