    proc ::intel_pcie_ss_axi::parameters::validate_high_freq_hwtcl { PROP_NAME PROP_VALUE   } {
        set g4_pld_clkfreq_user_hwtcl [ip_get "parameter.g4_pld_clkfreq_user_hwtcl.value"]
        set core16_axi_st_clk_freq_user_hwtcl [ip_get "parameter.core16_axi_st_clk_freq_user_hwtcl.value"]
        set core8_axi_st_clk_freq_user_hwtcl [ip_get "parameter.core8_axi_st_clk_freq_user_hwtcl.value"]
        set core4_0_axi_st_clk_freq_user_hwtcl [ip_get "parameter.core4_0_axi_st_clk_freq_user_hwtcl.value"]
        set core4_1_axi_st_clk_freq_user_hwtcl [ip_get "parameter.core4_1_axi_st_clk_freq_user_hwtcl.value"] 
        set high_speed_freq_hwtcl    [ip_get "parameter.high_speed_freq_hwtcl.value"]

        if {$high_speed_freq_hwtcl == 0} {
            ip_set_param "parameter.HIGH_SPEED.value" "BOTH_CLK"
        } else {
        if { $g4_pld_clkfreq_user_hwtcl > "350MHz" && ($core16_axi_st_clk_freq_user_hwtcl <= "350MHz" || $core8_axi_st_clk_freq_user_hwtcl <= "350MHz"|| $core4_0_axi_st_clk_freq_user_hwtcl <= "350MHz" || $core4_1_axi_st_clk_freq_user_hwtcl <= "350MHz")} {
            ip_set_param "parameter.HIGH_SPEED.value" "CORECLK_ONLY"
        } elseif { $g4_pld_clkfreq_user_hwtcl <= "350MHz" && ($core16_axi_st_clk_freq_user_hwtcl > "350MHz" || $core8_axi_st_clk_freq_user_hwtcl > "350MHz" || $core4_0_axi_st_clk_freq_user_hwtcl > "350MHz" || $core4_1_axi_st_clk_freq_user_hwtcl > "350MHz")} {
            ip_set_param "parameter.HIGH_SPEED.value" "AXICLK_ONLY"
        } elseif { $g4_pld_clkfreq_user_hwtcl <= "350MHz" && ($core16_axi_st_clk_freq_user_hwtcl <= "350MHz" || $core8_axi_st_clk_freq_user_hwtcl <= "350MHz" || $core4_0_axi_st_clk_freq_user_hwtcl <= "350MHz" || $core4_1_axi_st_clk_freq_user_hwtcl <= "350MHz")} {
            ip_set_param "parameter.HIGH_SPEED.value" "NONE"
        } elseif { $g4_pld_clkfreq_user_hwtcl > "350MHz" && ($core16_axi_st_clk_freq_user_hwtcl > "350MHz" || $core8_axi_st_clk_freq_user_hwtcl > "350MHz" || $core4_0_axi_st_clk_freq_user_hwtcl > "350MHz" || $core4_1_axi_st_clk_freq_user_hwtcl > "350MHz")} {
            ip_set_param "parameter.HIGH_SPEED.value" "BOTH_CLK"
       }

      }
    }
