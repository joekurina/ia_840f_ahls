				#   } else
					if {([regexp "Gen4 1x16, Interface - 512 bit" $top_topology] || [regexp "Gen4x8, Interface - 256 bit" $top_topology] || [regexp "Gen4x4, Interface - 128 bit" $top_topology]) && ($g4_pld_clkfreq_user == "250MHz" || $g4_pld_clkfreq_user == "225MHz" || $g4_pld_clkfreq_user == "200MHz" || $g4_pld_clkfreq_user == "175MHz")} {
