        ip_set_param "parameter.core16_FUNC_MODE.value" 	$func_mode
        ip_set_param "parameter.core8_FUNC_MODE.value" 	    $func_mode
        ip_set_param "parameter.core4_0_FUNC_MODE.value" 	$func_mode
        ip_set_param "parameter.core4_1_FUNC_MODE.value" 	$func_mode
    }
    
