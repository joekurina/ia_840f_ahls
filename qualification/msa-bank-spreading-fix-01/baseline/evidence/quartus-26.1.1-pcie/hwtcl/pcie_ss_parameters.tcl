    proc ::intel_pcie_ss_axi::parameters::validate_msix_table_size_hwtcl { PROP_NAME PROP_VALUE } {
        set core16_msix_table_en		[ip_get "parameter.core16_msix_en_table_hwtcl.value"]
        set core8_msix_table_en		    [ip_get "parameter.core8_msix_en_table_hwtcl.value"]
        set core16_msix_vector_alloc    [ip_get "parameter.core16_msix_vector_alloc_hwtcl.value"]
        set core8_msix_vector_alloc     [ip_get "parameter.core8_msix_vector_alloc_hwtcl.value"]
        set core16_total_pf_count       [ip_get "parameter.core16_total_pf_count_hwtcl.value"]
        set core8_total_pf_count        [ip_get "parameter.core8_total_pf_count_hwtcl.value"]

        set core16_sriov_en             [ip_get "parameter.core16_enable_sriov_hwtcl.value"]
        set core8_sriov_en              [ip_get "parameter.core8_enable_sriov_hwtcl.value"]
        
        set core16_count_msix_table_size 0
        set core16_total_msix_table_size 0
        set core8_count_msix_table_size 0
        set core8_total_msix_table_size 0

    	set top_topology_hwtcl [ip_get "parameter.top_topology_hwtcl.value"]

        switch $PROP_NAME {
            "core16_msix_table_size_hwtcl"       { ip_set_param "parameter.core16_MSIX_TABLE_SIZE.value" $PROP_VALUE  }
            "core8_msix_table_size_hwtcl"        { ip_set_param "parameter.core8_MSIX_TABLE_SIZE.value" $PROP_VALUE  }
            "core4_0_msix_table_size_hwtcl"      { ip_set_param "parameter.core4_0_MSIX_TABLE_SIZE.value" $PROP_VALUE  }
            "core4_1_msix_table_size_hwtcl"      { ip_set_param "parameter.core4_1_MSIX_TABLE_SIZE.value" $PROP_VALUE  }
        }

        if {$PROP_NAME == "core16_msix_table_size_hwtcl"} {
            #count total table size on active pf
            if {$core16_msix_table_en} {
                for { set i 0 } { $i < 8 } { incr i } {
                    if { [get_parameter_value core16_virtual_pf${i}_enable_hwtcl]} {
                         
                        #get pf table size
                        if {[get_parameter_value core16_virtual_pf${i}_msix_enable_user_hwtcl]} {
                            set core16_pf${i}_msix_table_size [expr [ip_get "parameter.core16_pf${i}_pci_msix_table_size_hwtcl.value"] + 1 ]
                        } else {
                            set core16_pf${i}_msix_table_size 0
                        }
                        
                        #get pf table size
                        if { $core16_sriov_en } {
                            if {[get_parameter_value core16_virtual_pf${i}_exvf_msix_cap_enable_hwtcl]} {
                                set core16_pf${i}_vf_msix_table_size [expr ([ip_get "parameter.core16_exvf_msix_tablesize_pf${i}.value"] + 1) * [ip_get "parameter.core16_pf${i}_vf_count_hwtcl.value"]]
                            } else {
                                set core16_pf${i}_vf_msix_table_size 0
                            }
                        } else {
                            set core16_pf${i}_vf_msix_table_size 0
                        }
                    } else {
                        set core16_pf${i}_msix_table_size 0
                        set core16_pf${i}_vf_msix_table_size 0
                    }
                }

                set core16_total_msix_table_size [expr $core16_pf0_msix_table_size + $core16_pf1_msix_table_size + \
                                                       $core16_pf2_msix_table_size + $core16_pf3_msix_table_size + \
                                                       $core16_pf4_msix_table_size + $core16_pf5_msix_table_size + \
                                                       $core16_pf6_msix_table_size + $core16_pf7_msix_table_size + \
                                                       $core16_pf0_vf_msix_table_size + $core16_pf1_vf_msix_table_size + \
                                                       $core16_pf2_vf_msix_table_size + $core16_pf3_vf_msix_table_size + \
                                                       $core16_pf4_vf_msix_table_size + $core16_pf5_vf_msix_table_size + \
                                                       $core16_pf6_vf_msix_table_size + $core16_pf7_vf_msix_table_size]
                
                ip_message info "The total MSI-X Table vectors in P-Tile PCIe0 is $core16_total_msix_table_size"
                if {$core16_msix_vector_alloc == "Static"} {
                    if {$core16_total_msix_table_size >= 4096 } {
                        ip_message error "The overall MSI-X Table size in P-Tile PCIe0 across all ${core16_total_pf_count} PF/VF Functions should not exceed the limit of 4096 vectors when PCIe Subsystem MSI-X Vector Allocation Policy is Static."
                    }
                }
            }
        }

        if { [regexp "2x8" $top_topology_hwtcl] } {
            if {$PROP_NAME == "core8_msix_table_size_hwtcl"} {
                #count total table size on active pf
                if {$core8_msix_table_en} {
                    for { set i 0 } { $i < 8 } { incr i } {
                        if { [get_parameter_value core8_virtual_pf${i}_enable_hwtcl]} {
                            
                            #get pf table size
                            if {[get_parameter_value core8_virtual_pf${i}_msix_enable_user_hwtcl]} {
                                set core8_pf${i}_msix_table_size [expr [ip_get "parameter.core8_pf${i}_pci_msix_table_size_hwtcl.value"] + 1 ]
                            } else {
                                set core8_pf${i}_msix_table_size 0
                            }
                            
                            #get pf table size
                            if { $core8_sriov_en } {
                                if {[get_parameter_value core8_virtual_pf${i}_exvf_msix_cap_enable_hwtcl]} {
                                    set core8_pf${i}_vf_msix_table_size [expr ([ip_get "parameter.core8_exvf_msix_tablesize_pf${i}.value"] + 1) * [ip_get "parameter.core8_pf${i}_vf_count_hwtcl.value"]]
                                } else {
                                    set core8_pf${i}_vf_msix_table_size 0
                                }
                            } else {
                                set core8_pf${i}_vf_msix_table_size 0
                            }
                        } else {
                            set core8_pf${i}_msix_table_size 0
                            set core8_pf${i}_vf_msix_table_size 0
                        }
                    }

                    set core8_total_msix_table_size [expr $core8_pf0_msix_table_size + $core8_pf1_msix_table_size + \
                                                        $core8_pf2_msix_table_size + $core8_pf3_msix_table_size + \
                                                        $core8_pf4_msix_table_size + $core8_pf5_msix_table_size + \
                                                        $core8_pf6_msix_table_size + $core8_pf7_msix_table_size + \
                                                        $core8_pf0_vf_msix_table_size + $core8_pf1_vf_msix_table_size + \
                                                        $core8_pf2_vf_msix_table_size + $core8_pf3_vf_msix_table_size + \
                                                        $core8_pf4_vf_msix_table_size + $core8_pf5_vf_msix_table_size + \
                                                        $core8_pf6_vf_msix_table_size + $core8_pf7_vf_msix_table_size]
                    
                    ip_message info "The total MSI-X Table vectors in P-Tile PCIe1 is $core8_total_msix_table_size"
                    if {$core8_msix_vector_alloc == "Static"} {
                        if {$core8_total_msix_table_size >= 4096 } {
                            ip_message error "The overall MSI-X Table size in P-Tile PCIe1 across all ${core16_total_pf_count} PF/VF Functions should not exceed the limit of 4096 vectors when PCIe Subsystem MSI-X Vector Allocation Policy is Static."}
                    }
                }
            }
        }
    }

