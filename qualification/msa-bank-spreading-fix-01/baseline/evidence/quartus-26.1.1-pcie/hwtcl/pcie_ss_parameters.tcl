    #AVST parameters validation
    proc ::intel_pcie_ss_axi::parameters::validate_core16_enable_adapter_hwtcl { } {
        set tile [ip_get "parameter.TILE.value"]
        if {$tile == "P-TILE"} {

            set top_topology_hwtcl [get_qhip_param_value "top_topology_hwtcl"]

        if  {[regexp "Gen4x16, Interface - 1024 bit" $top_topology_hwtcl] } {
            ip_set_param "parameter.core16_en_512s_to_1024s_adp_hwtcl.value" 1
        } else {
            ip_set_param "parameter.core16_en_512s_to_1024s_adp_hwtcl.value" 0
        }

         if  {[regexp "Gen4x16, Interface - 256 bit" $top_topology_hwtcl] } {
            ip_set_param "parameter.core16_en_512s_to_256s_adp_hwtcl.value" 1
        } else {
            ip_set_param "parameter.core16_en_512s_to_256s_adp_hwtcl.value" 0
        }

        if  {[regexp "Gen4x8, Interface - 512 bit" $top_topology_hwtcl] } {
            ip_set_param "parameter.core16_en_256s_to_512s_adp_hwtcl.value" 1
        } else {
            ip_set_param "parameter.core16_en_256s_to_512s_adp_hwtcl.value" 0
        }

        if  {[regexp "Gen4x8, Interface - 128 bit" $top_topology_hwtcl] } {
            ip_set_param "parameter.core16_en_256s_to_128s_adp_hwtcl.value" 1
        }  else {
            ip_set_param "parameter.core16_en_256s_to_128s_adp_hwtcl.value" 0
        }

        if  {[regexp "Gen4x4, Interface - 256 bit" $top_topology_hwtcl] } {
            ip_set_param "parameter.core16_en_128s_to_256s_adp_hwtcl.value" 1
        } else {
            ip_set_param "parameter.core16_en_128s_to_256s_adp_hwtcl.value" 0
