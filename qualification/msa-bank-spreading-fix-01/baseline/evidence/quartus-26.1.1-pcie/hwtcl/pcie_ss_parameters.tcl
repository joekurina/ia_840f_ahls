             set_qhip_param "topology_2x8_mode_hwtcl" "Root Port / Root Port" 
            }   
            if {$tile == "R-TILE" && [regexp "1x8" $topology]} {
             set_qhip_param "topology_1x8_mode_hwtcl" "Root Port"  
            }
            if {$tile == "R-TILE" && [regexp "4x4" $topology]} {
             set_qhip_param "topology_4x4_mode_hwtcl" "Root Port / Root Port / Root Port / Root Port"  
            }
            if {$tile == "R-TILE" && [regexp "1x4" $topology]} {
             set_qhip_param "topology_4x4_mode_hwtcl" "Root Port / Root Port / Root Port / Root Port"  
            }    
            if {$tile == "R-TILE" && [regexp "2x4" $topology]} {
             set_qhip_param "topology_4x4_mode_hwtcl" "Root Port / Root Port / Root Port / Root Port"  
           }

       } else  {
           if {$tile == "R-TILE" && [regexp "2x8" $topology]} {
             set_qhip_param "topology_2x8_mode_hwtcl" "Endpoint / Endpoint"	 
           }       
           if {$tile == "R-TILE" && [regexp "1x8" $topology]} {
             set_qhip_param "topology_1x8_mode_hwtcl" "Native Endpoint"	  
           }
           if {$tile == "R-TILE" && [regexp "4x4" $topology]} {
             set_qhip_param "topology_4x4_mode_hwtcl" "Endpoint / Endpoint / Endpoint / Endpoint"	  
           }
       }


    }

