       	} else {
       		if {  [regexp "x16" $top_topology_hwtcl] } {
       			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" { "Downstream" "Upstream" }
        	} elseif {  [regexp "x8" $top_topology_hwtcl] } {
        		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" { "Downstream / Downstream" "Upstream / Upstream" "Endpoint / Upstream" "Upstream / Endpoint" "Upstream / Downstream"}
        	} elseif {  [regexp "x4" $top_topology_hwtcl] } {
        		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" { "Downstream / Downstream / Downstream / Downstream" "Upstream / Upstream / Upstream / Upstream" }
            	}
            	if { [regexp "Downstream / Downstream / Downstream / Downstream" $PROP_VALUE] } {
            		::intel_pcie_ss_axi::parameters::set_core16_parameter_value core16_virtual_rp_ep_mode_hwtcl "Root Port"
