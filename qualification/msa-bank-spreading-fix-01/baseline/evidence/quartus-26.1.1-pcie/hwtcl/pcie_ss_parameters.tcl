    proc ::intel_pcie_ss_axi::parameters::validate_ss_axist_header_scheme { PROP_NAME PROP_VALUE } {
        switch $PROP_NAME {
            "core16_header_scheme_hwtcl"	{ ip_set_param "parameter.core16_HEADER_SCHEME.value"   $PROP_VALUE }
            "core8_header_scheme_hwtcl"	    { ip_set_param "parameter.core8_HEADER_SCHEME.value"    $PROP_VALUE }
		    "core4_0_header_scheme_hwtcl"	{ ip_set_param "parameter.core4_0_HEADER_SCHEME.value"  $PROP_VALUE }
		    "core4_1_header_scheme_hwtcl"	{ ip_set_param "parameter.core4_1_HEADER_SCHEME.value"  $PROP_VALUE }
        }
        if {$PROP_VALUE =="IN-BAND"} {
           if {$PROP_NAME == "core16_header_scheme_hwtcl"} {
            ip_set_param "parameter.core16_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" {"Simple"}
          }
           if {$PROP_NAME == "core8_header_scheme_hwtcl"} {
            ip_set_param "parameter.core8_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" {"Simple"}
          }
           if {$PROP_NAME == "core4_0_header_scheme_hwtcl"} {
            ip_set_param "parameter.core4_0_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" {"Simple"}
          }
           if {$PROP_NAME == "core4_1_header_scheme_hwtcl"} {
            ip_set_param "parameter.core4_1_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" {"Simple"}
          }

        } else {
             if {$PROP_NAME == "core16_header_scheme_hwtcl"} {
             ip_set_param "parameter.core16_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" { "Compact" "HIP-NATIVE"}
            }
             if {$PROP_NAME == "core8_header_scheme_hwtcl"} {
             ip_set_param "parameter.core8_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" { "Compact" "HIP-NATIVE"}
            }
             if {$PROP_NAME == "core4_0_header_scheme_hwtcl"} {
             ip_set_param "parameter.core4_0_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" { "Compact" "HIP-NATIVE"}
            }
             if {$PROP_NAME == "core4_1_header_scheme_hwtcl"} {
             ip_set_param "parameter.core4_1_Header_Packing_scheme_hwtcl.ALLOWED_RANGES" { "Compact" "HIP-NATIVE"}
            }

       }
