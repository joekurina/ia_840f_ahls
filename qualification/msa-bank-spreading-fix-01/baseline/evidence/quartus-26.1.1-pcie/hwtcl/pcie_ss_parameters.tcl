    proc ::intel_pcie_ss_axi::parameters::validate_pciess_ed_preset { PROP_NAME PROP_VALUE example_design_mode_hwtcl } {
        global QUARTUS_ROOTDIR
        set tile_name [ip_get "parameter.TILE.value"]

        if {${PROP_VALUE} } {
            ip_set "parameter.standard_interface_selection_hwtcl.value" 1
            if {$tile_name == "P-TILE" || $tile_name == "F-TILE"} {
                ip_set "parameter.hip_serial_standard_interface_selection_hwtcl.value" 1
            } else {
                ip_set "parameter.hip_serial_standard_interface_selection_hwtcl.value" 0
            }
        } else {
            ip_set "parameter.standard_interface_selection_hwtcl.value" 0
            if {$tile_name == "R-TILE"} {
                ip_set "parameter.hip_serial_standard_interface_selection_hwtcl.value" 0
            }
        }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_pciess_sim_hwtcl {PROP_NAME PROP_VALUE} {
        set topology [ip_get "parameter.top_topology_hwtcl.value"]
        set dtk_enable [ip_get "parameter.xcvr_reconfig_hwtcl.value"]
        set tile_name [ip_get "parameter.TILE.value"]

        if {($tile_name == "R-TILE" && [regexp "x4" $topology]) || $dtk_enable} {
            ip_set "parameter.enable_example_design_sim_hwtcl.ENABLED" false
            ip_set "parameter.enable_example_design_sim_hwtcl.VISIBLE" false
        } else {
            ip_set "parameter.enable_example_design_sim_hwtcl.ENABLED" true
            ip_set "parameter.enable_example_design_sim_hwtcl.VISIBLE" true

        }
    }

