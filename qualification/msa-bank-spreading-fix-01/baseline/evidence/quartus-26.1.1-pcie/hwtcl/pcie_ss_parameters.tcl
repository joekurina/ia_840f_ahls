		set_qhip_param "virtual_tlp_bypass_en_user_hwtcl" 0
		set_qhip_param "core16_virtual_tlp_bypass_en_hwtcl" 0
		set_qhip_param "core8_virtual_tlp_bypass_en_hwtcl" 0
		set_qhip_param "core4_0_virtual_tlp_bypass_en_hwtcl" 0
		set_qhip_param "core4_1_virtual_tlp_bypass_en_hwtcl" 0
        
	} else {
		set_qhip_param "virtual_tlp_bypass_en_user_hwtcl" 1
		if { $virtual_rp_ep_mode_hwtcl == "Endpoint / Upstream" } {
			# 2x8 ep/up
			ip_set_param "parameter.$PROP_NAME.value" "Bypass_Mix"
