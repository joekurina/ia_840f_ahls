    proc ::intel_pcie_ss_axi::parameters::_set_core16_msix_hwtcl {arg} {
        set msix_table_en		[ip_get "parameter.core16_msix_en_table_hwtcl.value"]
        set msix_table_size		[expr [ip_get "parameter.core16_msix_table_size_hwtcl.value"] - 1]
        set msix_bir		    [ip_get "parameter.core16_msix_bir_hwtcl.value"]
        set msix_bir_offset		[ip_get "parameter.core16_msix_bar_offset_hwtcl.value"]
        set msix_vector_alloc   [ip_get "parameter.core16_msix_vector_alloc_hwtcl.value"]
     	set sriov_enable                [ip_get "parameter.core16_enable_sriov_hwtcl.value"]

        if {$msix_vector_alloc == "Dynamic"} {
            ip_set_param "parameter.core16_msix_table_size_hwtcl.value" 2048
            set msix_table_size [expr 2048-1]
        }

        for { set i 0 } { $i < 8 } { incr i } {
            if { [get_parameter_value core16_virtual_pf${i}_enable_hwtcl] && $msix_table_en} {
                #if { ![get_parameter_value core16_pf${i}_virtio_capability_present_hwtcl] && ![get_parameter_value core16_pf${i}vf_virtio_capability_present_hwtcl] } {
                    set_qhip_profile_param "core16_virtual_pf${i}_msix_enable_user_hwtcl" $msix_table_en
                    if {$sriov_enable == 1} {
                    set_qhip_profile_param "core16_virtual_pf${i}_exvf_msix_cap_enable_hwtcl" $msix_table_en
                    }
                #}
            } else {
                set_qhip_profile_param "core16_virtual_pf${i}_msix_enable_user_hwtcl" 0
                set_qhip_profile_param "core16_virtual_pf${i}_exvf_msix_cap_enable_hwtcl" 0
            }
        }

        if {[check_parameter_validity core16_msix_table_size_hwtcl]} {
            for { set i 0 } { $i < 8 } { incr i } {
                if { [get_parameter_value core16_virtual_pf${i}_enable_hwtcl] && $msix_table_en } {
                    set_qhip_profile_param "core16_pf${i}_pci_msix_table_size_hwtcl" $msix_table_size
                    if {$sriov_enable == 1} {
                    set_qhip_profile_param "core16_exvf_msix_tablesize_pf${i}" $msix_table_size
                    }
                } else {
                    set_qhip_profile_param "core16_pf${i}_pci_msix_table_size_hwtcl" 0
                    set_qhip_profile_param "core16_exvf_msix_tablesize_pf${i}" 0
                }
            }
        }

        for { set i 0 } { $i < 8 } { incr i } {
            if { [get_parameter_value core16_virtual_pf${i}_enable_hwtcl] && $msix_table_en } {
                set_qhip_profile_param "core16_pf${i}_pci_msix_bir_hwtcl" $msix_bir
                set_qhip_profile_param "core16_pf${i}_pci_msix_pba_hwtcl" $msix_bir
                if {$sriov_enable == 1} {
                set_qhip_profile_param "core16_exvf_msixtable_bir_pf${i}" $msix_bir
                set_qhip_profile_param "core16_exvf_msixpba_bir_pf${i}" $msix_bir
                }
            } else {
                set_qhip_profile_param "core16_pf${i}_pci_msix_bir_hwtcl" 0
                set_qhip_profile_param "core16_pf${i}_pci_msix_pba_hwtcl" 0
                set_qhip_profile_param "core16_exvf_msixtable_bir_pf${i}" 0
                set_qhip_profile_param "core16_exvf_msixpba_bir_pf${i}" 0
            }
        }

        for { set i 0 } { $i < 8 } { incr i } {
            if { [get_parameter_value core16_virtual_pf${i}_enable_hwtcl] && $msix_table_en} {
                set_qhip_profile_param "core16_pf${i}_pci_msix_table_offset_hwtcl"  [expr $msix_bir_offset >> 3]
                set_qhip_profile_param "core16_pf${i}_pci_msix_pba_offset_hwtcl"    [expr ($msix_bir_offset + (($msix_table_size+1)*16) ) >> 3]
              	if {$sriov_enable == 1} {
                set_qhip_profile_param "core16_exvf_msixtable_offset_pf${i}"        [expr $msix_bir_offset >> 3]
                set_qhip_profile_param "core16_exvf_msixpba_offset_pf${i}"          [expr ($msix_bir_offset + (($msix_table_size+1)*16) ) >> 3 ]
              	}
            } else {
                set_qhip_profile_param "core16_pf${i}_pci_msix_table_offset_hwtcl"  0
                set_qhip_profile_param "core16_pf${i}_pci_msix_pba_offset_hwtcl"    0
                set_qhip_profile_param "core16_exvf_msixtable_offset_pf${i}"        0
                set_qhip_profile_param "core16_exvf_msixpba_offset_pf${i}"          0
            }
        }
    }

