        if {$pcie_ss_profile_mode_value =="Virtual+"} {
            ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
        }
        if {$tile =="P-TILE" &&($topology =="Gen4 4x4"||$topology =="Gen4 1x4"||$topology=="Gen4 2x4" ||$topology =="Gen3 4x4"||$topology =="Gen3 1x4"||$topology=="Gen3 2x4") && ($pcie_ss_profile_mode_value =="Basic"||$pcie_ss_profile_mode_value =="Basic+"||$pcie_ss_profile_mode_value =="Virtual" ||$pcie_ss_profile_mode_value =="Virtual+")} {
