    proc ::intel_pcie_ss_axi::parameters::validate_hssi_ctr_is_cvp_enable_hwtcl {PROP_NAME PROP_VALUE hssi_ctr_is_cvp_enable_hwtcl} {
        
        set cvp         [ip_get "parameter.core16_pcie_cvp_attr_hwtcl.value"]
        set tile        [ip_get "parameter.TILE.value"]
        if {$tile == "R-TILE"} {
            if {$cvp == 1} {
                ip_set_param "parameter.hssi_ctr_is_cvp_enable_hwtcl.value" 1
                ip_set_param "parameter.core16_cii_range_0_k_cii_addr_size0_attr_user_hwtcl.ALLOWED_RANGES" {0:3327}
                ip_set_param "parameter.core16_cii_range_0_k_cii_addr_size0_attr_user_hwtcl.value" 3327
                ip_set_param "parameter.core16_cii_range_1_k_cii_start_addr1_attr_user_hwtcl.ALLOWED_RANGES" {0:3428}
                ip_set_param "parameter.core16_cii_range_1_k_cii_start_addr1_attr_user_hwtcl.value" 3428
                ip_set_param "parameter.core16_cii_range_1_k_cii_addr_size1_attr_user_hwtcl.value" 667
            } else {
                ip_set_param "parameter.hssi_ctr_is_cvp_enable_hwtcl.value" 0
                ip_set_param "parameter.core16_cii_range_0_k_cii_addr_size0_attr_user_hwtcl.ALLOWED_RANGES" {0:4095}
                ip_set_param "parameter.core16_cii_range_0_k_cii_addr_size0_attr_user_hwtcl.value" 4095
                ip_set_param "parameter.core16_cii_range_1_k_cii_start_addr1_attr_user_hwtcl.ALLOWED_RANGES" {0:4095}
                ip_set_param "parameter.core16_cii_range_1_k_cii_start_addr1_attr_user_hwtcl.value" 0
                ip_set_param "parameter.core16_cii_range_1_k_cii_addr_size1_attr_user_hwtcl.value" 0
            }
        }
    }

