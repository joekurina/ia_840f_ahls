    proc ::intel_pcie_ss_axi::parameters::validate_core16_enable_virtio_hwtcl { } {
    set tile        [ip_get "parameter.TILE.value"]
    set topology    [ip_get "parameter.top_topology_hwtcl.value"]
    
    if {$tile == "F-TILE"} {

    if { [regexp "1x4" $topology] } {
       ip_set_param "parameter.core16_enable_virtio_hwtcl.VISIBLE" false
       }
    }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_core16_ctrl_shadow_en_hwtcl { } {
    set tile               [ip_get "parameter.TILE.value"]
    set topology           [ip_get "parameter.top_topology_hwtcl.value"]
  
        if {$tile == "F-TILE"} {
        set topology    [ip_get "parameter.top_topology_hwtcl.value"]
        if { [regexp "1x4" $topology] } {
           ip_set_param "parameter.core16_ctrl_shadow_en_hwtcl.VISIBLE" false
           }
         }
    }
 
    #vww27 added 
    proc ::intel_pcie_ss_axi::parameters::validate_syspll_enabled_hwtcl { PROP_NAME PROP_VALUE } {
	
	set tile [ip_get "parameter.TILE.value"]
	set syspll_en [ip_get "parameter.syspll_enabled_hwtcl.value"]
	
	 if {$tile == "F-TILE"} {
		
						
		add_interface refclk0 ftile_hssi_reference_clock sink
		add_interface_port refclk0 refclk0 ftile_hssi_reference_clock input 1	
		add_interface refclk1 ftile_hssi_reference_clock sink
		add_interface_port refclk1 refclk1 ftile_hssi_reference_clock input 1		
	
		set_interface_property refclk0         clockRate 100000000
       	 	set_interface_property refclk1         clockRate 100000000
		set_port_property refclk0 ROLE clk
		set_port_property refclk1 ROLE clk
		set_port_property refclk0 TERMINATION false
		set_port_property refclk1 TERMINATION false
		set_port_property refclk0 DESCRIPTION "<html>Refclk for SystemPLL and PCIe PHY. Connect a refclk output \"out_refclk_fgt_<i>i</i>\" from the \"F-Tile Reference and SystemPLL Clocks\" IP to this port.</html>"
            	set_port_property refclk1 DESCRIPTION "<html>Refclk for PCIe1 PHY in 2x8 topology. Drive this input with the same clock for refclk0 input port, if:<br>- Your design does not need a separate refclk, or<br>- You are not using 2x8 topology.</html>"
		
		
        } elseif {$tile == "P-TILE" || $tile == "R-TILE"} {

		add_interface refclk0 clock sink
		add_interface_port refclk0 refclk0 clock input 1	
		add_interface refclk1 clock sink
		add_interface_port refclk1 refclk1 clock input 1
		
		set_interface_property refclk0         clockRate 100000000
       	 	set_interface_property refclk1         clockRate 100000000
		set_port_property refclk0 ROLE clk
		set_port_property refclk1 ROLE clk
		set_port_property refclk0 TERMINATION false
		set_port_property refclk1 TERMINATION false
            	set_port_property refclk0 DESCRIPTION "Check User Guide for details"
            	set_port_property refclk1 DESCRIPTION "Check User Guide for details"
       
        }


    }

    proc ::intel_pcie_ss_axi::parameters::_set_tile_hwtcl { arg } {

        global qhip_param
        #clear dict 
        dict for {key val} $qhip_param {
            dict unset qhip_param $key
        }
        set tile [ip_get "parameter.TILE_user.value"]
        if {$tile == "F-TILE" } {
        ip_set_param "parameter.top_topology_hwtcl.value" "Gen4 2x8"
        ip_set_param "parameter.core16_dwidth_byte_user_hwtcl.value" 128
        ip_set_param "parameter.core16_num_seg_user_hwtcl.value" 4
        ip_set_param "parameter.core8_dwidth_byte_user_hwtcl.value" 128
        ip_set_param "parameter.core8_num_seg_user_hwtcl.value" 4
        ip_set_param "parameter.core4_0_dwidth_byte_user_hwtcl.value" 32
        ip_set_param "parameter.core4_0_num_seg_user_hwtcl.value" 1
        ip_set_param "parameter.core4_1_dwidth_byte_user_hwtcl.value" 32
        ip_set_param "parameter.core4_1_num_seg_user_hwtcl.value" 1
        ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"

        set g4_pld              [ip_get "parameter.g4_pld_clkfreq_user_hwtcl.value"]
            ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core4_0_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core4_1_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            
        }
        if {$tile == "R-TILE"} {
        ip_set_param "parameter.top_topology_hwtcl.value" "Gen4 2x8"
        ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.value" "500MHz"
        set g4_pld              [ip_get "parameter.g4_pld_clkfreq_user_hwtcl.value"]
            ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core4_0_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.core4_1_axi_st_clk_freq_user_hwtcl.value" $g4_pld
            ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
        
        }

 }
    proc ::intel_pcie_ss_axi::parameters::validate_tile_hwtcl { PROP_NAME PROP_VALUE } {
        global qhip_param
        #clear dict 
            #dict for {key val} $qhip_param {}
            #dict unset qhip_param $key
        #{}

	set device_die_revisions [ip_get "parameter.device_die_revisions.value"]

        # Controlling TILE and TILE_user visibility
        if {[regexp "WHR" $device_die_revisions]} {
             ip_set_param "parameter.TILE_user.VISIBLE" false
             ip_set_param "parameter.TILE.VISIBLE" true
        
        } elseif {[regexp "GDR" $device_die_revisions]&& ![regexp "RNR" $device_die_revisions]} {
             ip_set_param "parameter.TILE_user.VISIBLE" false
             ip_set_param "parameter.TILE.VISIBLE" true
        
        } elseif {[regexp "RNR" $device_die_revisions] && ![regexp "GDR" $device_die_revisions]} {
             ip_set_param "parameter.TILE_user.VISIBLE" false
             ip_set_param "parameter.TILE.VISIBLE" true

        } elseif {[regexp "RNR" $device_die_revisions] && [regexp "GDR" $device_die_revisions]} {
             ip_set_param "parameter.TILE_user.VISIBLE" true
             ip_set_param "parameter.TILE.VISIBLE" false

        }


        #vww18 added to set parameter properties based on tile selection
        #ptile and ftile 
        set tile [ip_get "parameter.TILE.value"]
	set syspll_en [ip_get "parameter.syspll_enabled_hwtcl.value"]

        if {$tile == "P-TILE"} {
            ip_set_param "parameter.CPL_BUFF_HDR_DOUBLE_DEPTH.HDL_PARAMETER" false
           ip_set_param "parameter.rtile_debug_toolkit_hwtcl.HDL_PARAMETER" false
           ip_set_param "parameter.qhip_silicon_reva_revb_hwtcl.HDL_PARAMETER" false
           ip_set_param "parameter.qhip_mmio_enable_hwtcl.HDL_PARAMETER" false
           ip_set_param "parameter.independent_perst_int_hwtcl.HDL_PARAMETER" false
           ip_set_param "parameter.qhip_silicon_revc_hwtcl.HDL_PARAMETER" false
           ip_set_param "parameter.top_topology_hwtcl.ALLOWED_RANGES" {"Gen4 1x16" "Gen4 1x8" "Gen4 2x8" "Gen4 4x4" "Gen4 1x4" "Gen4 2x4" "Gen3 1x16" "Gen3 1x8" "Gen3 2x8" "Gen3 4x4" "Gen3 1x4" "Gen3 2x4"}

            set virtual_rp_ep_mode [ip_get "parameter.virtual_rp_ep_mode_hwtcl.value"]
            if {$virtual_rp_ep_mode =="Root Port"} {                  
                      ip_set_param  "parameter.core16_enable_cii_hwtcl.value"  0
                      ip_set_param  "parameter.core8_enable_cii_hwtcl.value"   0
                      ip_set_param  "parameter.core4_0_enable_cii_hwtcl.value" 0
                      ip_set_param  "parameter.core4_1_enable_cii_hwtcl.value" 0
                 
            }

            set topology                        [ip_get "parameter.top_topology_hwtcl.value"]

          if {$topology =="Gen4 1x16" ||$topology =="Gen4 2x8"} {
           ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ALLOWED_RANGES" {"500MHz" "450MHz" "400MHz" "350MHz" "250MHz" "225MHz" "200MHz" "175MHz"}
          }
           if {$topology =="Gen4 1x8" ||$topology =="Gen4 1x4" ||$topology =="Gen4 2x4"} {
           ip_set_param "parameter.g4_pld_clkfreq_user_hwtcl.ALLOWED_RANGES" {"500MHz" "450MHz" "400MHz" "350MHz"}
          }
          if {$topology =="Gen3 1x16" ||$topology =="Gen3 2x8" ||$topology =="Gen3 1x8" ||$topology =="Gen3 1x4" ||$topology =="Gen3 2x4"} {
           ip_set_param "parameter.g3_pld_clkfreq_user_hwtcl.ALLOWED_RANGES" {"250MHz"}
          }


           foreach core [list "16" "8"] {
              for {set pf 0} {$pf <8} {incr pf 1} {
                  ip_set_param "parameter.core${core}_pf${pf}_pci_type0_vendor_id_user_hwtcl.VISIBLE" false
                  ip_set_param "parameter.core${core}_pf${pf}_revision_id_user_hwtcl.VISIBLE" false
                  for {set i 0} {$i <6} {incr i 1} {
                  set_parameter_property hssi_ctp_u_wrpcie_top_u_core${core}_pf${pf}_sriov_vf_bar${i}_type_r HDL_PARAMETER false
                  }
              }
           }
	   foreach core [list "4_0" "4_1"] {
		  ip_set_param "parameter.core${core}_pf0_pci_type0_vendor_id_hwtcl.VISIBLE" false
                  ip_set_param "parameter.core${core}_pf0_revision_id_hwtcl.VISIBLE" false
	   }
            set_parameter_property core16_enable_pld_warm_rst_rdy_hwtcl "VISIBLE" TRUE
            set_parameter_property core16_user_mode_to_pld_in_use_hwtcl "VISIBLE" TRUE
            set_parameter_property core16_user_pcie_cap_ep_l1_accpt_latency_hwtcl "ENABLED" TRUE
          for {set pf 0} {$pf <8} {incr pf 1} {            
            set_parameter_property core16_virtual_pf${pf}_msi_64b_addressing_user_hwtcl "VISIBLE" TRUE
            set_parameter_property core16_pf${pf}_pci_msi_ext_data_cap_hwtcl "VISIBLE" TRUE
            set_parameter_property core16_pf${pf}_pci_msi_multiple_msg_cap_hwtcl "VISIBLE" TRUE
