    proc ::intel_pcie_ss_axi::parameters::validate_pcs_config_en { } {
         set tile [ip_get "parameter.TILE.value"]
        if {$tile == "F-TILE"} {
            if { [get_quartus_ini "pcie_pcs_config_en"] } {
            ip_set_param "parameter.PCS_CONFIG_EN.VISIBLE" true
            } else {
            ip_set_param "parameter.PCS_CONFIG_EN.VISIBLE" false
            }
        
            set pcs_config_en        [get_parameter_value PCS_CONFIG_EN]
            set top_topology_hwtcl   [ip_get "parameter.top_topology_hwtcl.value"]
            if {$pcs_config_en} {
                if { [regexp "2x4" $top_topology_hwtcl] } {
                    send_message info "PCIe 0: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 1: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 2: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    ip_set_param "parameter.core16_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core16_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core8_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core4_0_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "1x8" $top_topology_hwtcl] } {
                    send_message info "PCIe 0: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 1: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    ip_set_param "parameter.core16_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core16_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core8_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "1x4" $top_topology_hwtcl] } {
                    send_message info "PCIe 0: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    ip_set_param "parameter.core16_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core16_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "1x16" $top_topology_hwtcl] || [regexp "2x8" $top_topology_hwtcl] || [regexp "4x4" $top_topology_hwtcl] } {
                    send_message info "PCIe 0: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 1: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 2: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    send_message info "PCIe 3: HIP reconfiguration automatically enabled when PCS Register Access is enabled"
                    ip_set_param "parameter.core16_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core16_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core8_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core4_0_hip_reconfig_user_hwtcl.ENABLED" false
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 1
                    ip_set_param "parameter.core4_1_hip_reconfig_user_hwtcl.ENABLED" false
                }
            } elseif {!$pcs_config_en} {
                if { [regexp "1x16" $top_topology_hwtcl] } {
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "1x8" $top_topology_hwtcl] } {
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "2x8" $top_topology_hwtcl] } {
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "1x4" $top_topology_hwtcl] } {
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_0_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                } elseif { [regexp "2x4" $top_topology_hwtcl] } {
                    ip_set_param "parameter.core8_hip_reconfig_hwtcl.value" 0
                    ip_set_param "parameter.core4_1_hip_reconfig_hwtcl.value" 0
                }
            }
	    }
	}

