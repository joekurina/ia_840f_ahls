    proc ::intel_pcie_ss_axi::parameters::validate_hip_native_mode_user_hwtcl {} {
        set core16_hip_native        [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
        set core8_hip_native         [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
        set core4_0_hip_native       [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
        set core4_1_hip_native       [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
        set topology                 [ip_get "parameter.top_topology_hwtcl.value"]
        set tile                     [ip_get "parameter.TILE.value"]
        set message ""

        # Check for R-TILE and Gen4/5 condition
        if { $tile == "R-TILE" } {
            if { [string match "*Gen4*" $topology] || [string match "*Gen5*" $topology] } {
                if { [string match "*x16*" $topology] && !$core16_hip_native } {
                    set message "Please select 500Mhz before closing hip native mode on Gen4/5 for x16 topology."
                } elseif { [string match "*x8*" $topology] && (!$core8_hip_native || !$core16_hip_native) } {
                    set message "Please select 500Mhz before closing hip native mode on Gen4/5 for x8 topology."
                } elseif { [string match "*x4*" $topology] && (!$core4_0_hip_native || !$core4_1_hip_native || !$core16_hip_native) } {
                    set message "Please select 500Mhz before closing hip native mode on Gen4/5 for x4 topology."
                }
            }
        } elseif { [string match "*Gen3*" $topology] } {
            if { [string match "*x16*" $topology] && !$core16_hip_native } {
                set message "Please select 250Mhz before closing hip native mode on Gen3 for x16 topology."
            } elseif { [string match "*x8*" $topology] && (!$core8_hip_native || !$core16_hip_native) } {
                set message "Please select 250Mhz before closing hip native mode on Gen3 for x8 topology."
            } elseif { [string match "*x4*" $topology] && (!$core4_0_hip_native || !$core4_1_hip_native || !$core16_hip_native) } {
                set message "Please select 250Mhz before closing hip native mode on Gen3 for x4 topology."
            }
        }
         
        # Display the message if it has been set
           if { $message != "" } {
               ip_message info $message
           }

        # Check if any of the values contain the substring "x4"
        if {[string match "*4x*" $topology]} {
            if { $core16_hip_native != $core8_hip_native || $core16_hip_native != $core4_0_hip_native || $core16_hip_native != $core4_1_hip_native } {
                ip_message error "The hip_native mode must be the same for all port."
            }
        }
    
        # Check if any of the values contain the substring "2x"
        if {[string match "*2x*" $topology]} {
            if { $core16_hip_native != $core8_hip_native } {
                ip_message error "The hip_native mode must be the same for all port."
            }
        }

        foreach core [list "16" "8" "4_0" "4_1"] {
            if {$tile == "P-TILE" || $tile == "F-TILE"} {
                ip_set_param "parameter.core${core}_hip_native_mode_hwtcl.value" 0
            } else {
                ip_set_param "parameter.core${core}_hip_native_mode_hwtcl.value" 1
            }
        }
    }

   proc ::intel_pcie_ss_axi::parameters::validate_ss_axist_idbw { PROP_NAME PROP_VALUE } {
        switch $PROP_VALUE {
            16          { set idw_value 128 }
            32      	{ set idw_value 256  }
            64    		{ set idw_value 512  }
            128         { set idw_value 1024 }
        }
        if { $PROP_NAME == "core16_dwidth_byte_hwtcl"} {
            ip_set_param "parameter.core16_DWIDTH.value"    $idw_value
        }
        if { $PROP_NAME == "core8_dwidth_byte_hwtcl"} {
            ip_set_param "parameter.core8_DWIDTH.value"     $idw_value
        }
        if { $PROP_NAME == "core4_0_dwidth_byte_hwtcl"} {
            ip_set_param "parameter.core4_0_DWIDTH.value"	$idw_value
        }
        if { $PROP_NAME == "core4_1_dwidth_byte_hwtcl"} {
            ip_set_param "parameter.core4_1_DWIDTH.value"	$idw_value
        }  
        

   }
   proc ::intel_pcie_ss_axi::parameters::validate_ss_axist_idbw_user { PROP_NAME PROP_VALUE } {
        set core16_hip_native        [ip_get "parameter.core16_hip_native_mode_user_hwtcl.value"]
        set core8_hip_native         [ip_get "parameter.core8_hip_native_mode_user_hwtcl.value"]
        set core4_0_hip_native       [ip_get "parameter.core4_0_hip_native_mode_user_hwtcl.value"]
        set core4_1_hip_native       [ip_get "parameter.core4_1_hip_native_mode_user_hwtcl.value"]
        set topology                 [ip_get "parameter.top_topology_hwtcl.value"]
        set tile                     [ip_get "parameter.TILE.value"]        
                     
      
      if { [regexp "core16" $PROP_NAME]} {
        if {$topology =="Gen5 1x16" } {
