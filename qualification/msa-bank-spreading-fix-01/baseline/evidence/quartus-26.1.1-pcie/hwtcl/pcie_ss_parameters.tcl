     if {$tile =="R-TILE"} {
        if {$topology =="Gen5 1x16" ||$topology =="Gen4 1x16" ||$topology =="Gen5 1x8" ||$topology =="Gen4 1x8" ||$topology =="Gen4 1x4"} {
            if {$core16_hip_native ==1} {
              ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ALLOWED_RANGES" {"500MHz" "475MHz" "470MHz" "450MHz" "425MHz" "400MHz" "350MHz" "250MHz"} 
