        		set_qhip_param "core16_virtual_tlp_bypass_en_hwtcl" 1
        		set_qhip_param "core8_virtual_tlp_bypass_en_hwtcl" 0
        		set_qhip_param "core4_0_virtual_tlp_bypass_en_hwtcl" 0
        		set_qhip_param "core4_1_virtual_tlp_bypass_en_hwtcl" 0
            
        	} else {
        		# 4x4 all up or all dp, 2x8 up/dp or up/up or dp/dp, 1x16 up or dp
        		ip_set_param "parameter.$PROP_NAME.value" "Bypass_Enable"
        		::intel_pcie_ss_axi::parameters::set_core16_parameter_value core16_virtual_tlp_bypass_en_hwtcl 1
        		::intel_pcie_ss_axi::parameters::set_core8_parameter_value core8_virtual_tlp_bypass_en_hwtcl 1
        		::intel_pcie_ss_axi::parameters::set_core4_0_parameter_value core4_0_virtual_tlp_bypass_en_hwtcl 1
