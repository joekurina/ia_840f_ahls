    proc ::intel_pcie_ss_axi::parameters::set_qhip_param_profile_default {qparam_list} {
    	    set pcie_link_en_value [ip_get "parameter.pcie_link_en_hwtcl.value"]
    	    set total_param_list [llength $qparam_list]
    	    if {$pcie_link_en_value} {
                for { set index_qhip_param 1}  {$index_qhip_param < $total_param_list} {incr index_qhip_param} {
                    set qhip_param_list [lindex [lindex $qparam_list $index_qhip_param] 0]
                    set qhip_param_value [ip_get "parameter.$qhip_param_list.default_value"]
                    set_qhip_profile_param $qhip_param_list $qhip_param_value
                }
    	    } else {
                for { set index_qhip_param 1}  {$index_qhip_param < $total_param_list} {incr index_qhip_param} {
                    set qhip_param_list [lindex [lindex $qparam_list $index_qhip_param] 0]
                    if {[regexp "ceb" $qhip_param_list] || [regexp "vsec" $qhip_param_list]} {
                        set qhip_param_value [ip_get "parameter.$qhip_param_list.value"]
                        set_qhip_profile_param $qhip_param_list $qhip_param_value
                    } else {
                        set qhip_param_value [ip_get "parameter.$qhip_param_list.default_value"]
                        set_qhip_profile_param $qhip_param_list $qhip_param_value
                    }


                }
    	    }
    }
    
    
