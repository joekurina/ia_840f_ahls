       		ip_set "parameter.core4_0_tlp_bypass_isDownstream_hwtcl.value" 0
       		ip_set "parameter.core4_1_tlp_bypass_isDownstream_hwtcl.value" 0
       
       		set_qhip_param "core16_tlp_bypass_isDownstream_hwtcl" 0
       		set_qhip_param "core8_tlp_bypass_isDownstream_hwtcl" 0
       		set_qhip_param "core4_0_tlp_bypass_isDownstream_hwtcl" 0
