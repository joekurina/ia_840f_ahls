    proc ::intel_pcie_ss_axi::parameters::upgrade {ip_name version old_params} {
        # Generic best-effort upgrade
        set all_params [get_parameters]
        foreach { name value } $old_params {
            if {[lsearch -exact $all_params $name] != -1} {
                ip_set "parameter.$name.value" $value
            } else {
                ip_message warning "Parameter ${name} no longer exists in the current IP version and is not set. It was set to ${value}"
            }
        }
        # back-to-back reset support
        if {[package vcompare $version 5.0.0] < 0} {
            ip_set "parameter.ptile_b2b_reset_hwtcl.value" 0
        } 
    }

