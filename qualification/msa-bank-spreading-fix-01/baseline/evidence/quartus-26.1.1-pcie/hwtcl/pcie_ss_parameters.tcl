    proc ::intel_pcie_ss_axi::parameters::validate_func_mode_hwtcl { PROP_NAME PROP_VALUE top_topology_hwtcl virtual_rp_ep_mode_hwtcl } {
	    set func_mode "pcie_"
	    if { [regexp "Gen3" $top_topology_hwtcl] } {
		append func_mode "g3_"
	    } elseif { [regexp "Gen4" $top_topology_hwtcl] } {
		append func_mode "g4_"
	    } elseif { [regexp "Gen5" $top_topology_hwtcl] } {
        append func_mode "g5_"
        }
	    if { [regexp "x16" $top_topology_hwtcl] } {
		append func_mode "x16_"
	    } elseif { [regexp "x8" $top_topology_hwtcl] } {
		append func_mode "x8x8_"
	    } elseif { [regexp "x4" $top_topology_hwtcl] } {
		append func_mode "x4x4x4x4_"
	    } 
	
	    if { [regexp "Root/Endpoint" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "rpep"
	    } elseif { [regexp "Root Port" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "rp"
	    } elseif { [regexp "Downstream / Downstream / Downstream / Downstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "rp"
	    } elseif { [regexp "Upstream / Upstream / Upstream / Upstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "ep"
	    } elseif { [regexp "Upstream / Upstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "ep"
	    } elseif { [regexp "Downstream / Downstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "dp"
	    } elseif { [regexp "Upstream / Downstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "updp"
	    } elseif { [regexp "Endpoint / Upstream" $virtual_rp_ep_mode_hwtcl] || [regexp "Upstream / Endpoint" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "epup"
	    } elseif { [regexp "Upstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "ep"
	    } elseif { [regexp "Downstream" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "rp"
	    } elseif { [regexp "Endpoint" $virtual_rp_ep_mode_hwtcl] } {
		append func_mode "ep"
	    } 
	    ip_set_param "parameter.hssi_ctp_func_mode.value" $func_mode

    }

    proc ::intel_pcie_ss_axi::parameters::validate_topology_hwtcl { PROP_NAME PROP_VALUE top_topology_hwtcl  virtual_tlp_bypass_en_hwtcl virtual_rp_ep_mode_hwtcl } {
    set tile [ip_get "parameter.TILE.value"]
        if { [regexp "x16" $top_topology_hwtcl] } {
            ip_set_param "parameter.hssi_ctp_topology.value"  "pcie_x16"
        } elseif { [regexp "x8" $top_topology_hwtcl] } {
            ip_set_param "parameter.hssi_ctp_topology.value"  "pcie_x8x8"
        } elseif { [regexp "x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.hssi_ctp_topology.value"  "pcie_x4x4x4x4"
	
        }
     if {$tile == "F-TILE"} {
     	if { [regexp "1x16" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X16"
        } elseif { [regexp "2x8" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X8X8"
        } elseif { [regexp "4x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X4x4x4x4"
        } elseif { [regexp "1x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X4"
        } elseif { [regexp "2x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X4x4"
        } elseif { [regexp "1x8" $top_topology_hwtcl] } {
            ip_set_param "parameter.topology.value"  "PCIE_X8"
        }
     }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_pcie_ss_topology_hwtcl { PROP_NAME PROP_VALUE top_topology_hwtcl  virtual_tlp_bypass_en_hwtcl virtual_rp_ep_mode_hwtcl } {
        if { [regexp "x16" $top_topology_hwtcl] } {
            ip_set_param "parameter.pciess_topology.value"  "pcie_x16"
