        }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_devkit { PROP_NAME PROP_VALUE device } {
        set opn $device
        set tile_name [ip_get "parameter.TILE.value"]

        if {$tile_name == "P-TILE"} {
            ip_set_param "parameter.chosen_devkit_hwtcl.ALLOWED_RANGES" {"NONE" "Agilex 7 FPGA F-Series Development Kit (Production 1 P-Tile & E-Tile)"} 
            switch $PROP_VALUE {
                "Agilex 7 FPGA F-Series Development Kit (Production 1 P-Tile & E-Tile)"   { set opn "AGFB014R24B2E2V" }
            }
        } elseif {$tile_name == "R-TILE"} {

            # ip_set_param "parameter.chosen_devkit_hwtcl.ALLOWED_RANGES" {"NONE" "Agilex 7 FPGA I-Series Development Kit (ES 2x R-Tile & 1x F-Tile)" "Agilex 7 FPGA I-Series Development Kit (ES1 2x R-Tile & 1x F-Tile)"} 
            ip_set_param "parameter.chosen_devkit_hwtcl.ALLOWED_RANGES" {"NONE" "Agilex 7 FPGA I-Series Development Kit (ES1 2x R-Tile & 1x F-Tile)" "Agilex 7 FPGA I-Series Development Kit (ES2 2x R-Tile & 1x F-Tile)" "Agilex 7 FPGA I-Series Development Kit (Production 2x R-Tile & 1x F-Tile)"} 

            switch $PROP_VALUE {
                "Agilex 7 FPGA I-Series Development Kit (ES1 2x R-Tile & 1x F-Tile)"      		{ set opn "AGIB027R29A1E2VR3" }
                "Agilex 7 FPGA I-Series Development Kit (ES2 2x R-Tile & 1x F-Tile)"      		{ set opn "AGIB027R29A1E2VR3" }
                "Agilex 7 FPGA I-Series Development Kit (Production 2x R-Tile & 1x F-Tile)"       { set opn "AGIB027R29A1E1VB" }
            } 
                # "Agilex 7 FPGA I-Series Development Kit (ES 2x R-Tile & 1x F-Tile)"      		{ set opn "AGIB027R29A1E2VR0" }
        } elseif {$tile_name == "F-TILE"} {

            ip_set_param "parameter.chosen_devkit_hwtcl.ALLOWED_RANGES" {"NONE" "Agilex 7 FPGA F-Series Development Kit (Production 1 2x F-Tile)"} 

            switch $PROP_VALUE {
               
	       "Agilex 7 FPGA F-Series Development Kit (Production 1 2x F-Tile)" { set opn "AGFD023R24C2E1VC" }
            } 
