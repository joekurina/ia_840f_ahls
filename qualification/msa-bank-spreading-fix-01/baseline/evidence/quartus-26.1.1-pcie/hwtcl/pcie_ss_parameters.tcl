    proc ::intel_pcie_ss_axi::parameters::set_core16_bar_param {} {
        set tile [ip_get "parameter.TILE.value"]
        if {$tile == "P-TILE" ||$tile =="R-TILE"} {
                #set core16_bar_params {{address_width_user_hwtcl} {address_width_hwtcl} {address_width_int_hwtcl}}
                
                #params:   
                #core16_pf$a_bar$b_address_width_user_hwtcl         =>   "pf0 -> bar: 0-5" "pf1 -> bar: 0-5" (should be until pf7 -> bar0-bar5)
                #core16_pf$a_bar$b_address_width_hwtcl              =>   "pf0 -> bar: 0-5" "pf1 -> bar: 0-5"
                #core16_pf${a}_sriov_vf_bar${b}_address_width_hwtcl     =>   "pf0 -> bar: 0-5" 
                #core16_pf${a}_sriov_vf_bar${b}_address_width_int_hwtcl =>   "pf0 -> bar: 0-5" 

                for {set a 0} {$a < 8} {incr a} {
                    for {set b 0} {$b < 6} {incr b} {
                        set bar_param "core16_pf${a}_bar${b}_address_width_user_hwtcl"
                        set_parameter_property $bar_param "ALLOWED_RANGES" {"0:N/A" "7: 128 Bytes - 7 bits" "8: 256 Bytes - 8 bits" \
                                                                                                        "9: 512 Bytes - 9 bits" "10: 1 KByte - 10 bits" "11: 2 KBytes - 11 bits" "12: 4 KBytes - 12 bits" "13: 8 KBytes - 13 bits" \
