                #ip_message info "Device Address Translation Table is Enabled."
			}
    	}
    	
        if {$pcie_ss_func_mode_value == "AXI-MM Data Mover" } {
			if {$pcie_ss_profile_value == "Basic"} {
				#set basic profile qhip param and gui non derived param 
				_set_pcie_ss_profile_basic 
			}  elseif {$pcie_ss_profile_value == "Basic+"} {
				_set_pcie_ss_profile_basic_plus 
                #ip_message info "Device Address Translation Table is Enabled."
			} elseif {$pcie_ss_profile_value == "Virtual"} {
				_set_pcie_ss_profile_virtual 
			} elseif {$pcie_ss_profile_value == "Virtual+"} {
				_set_pcie_ss_profile_virtual_plus 
                #ip_message info "Device Address Translation Table is Enabled."
			}
    	}
    }    

    proc ::intel_pcie_ss_axi::parameters::_set_pcie_ss_profile_basic {} {
    	set topology [ip_get "parameter.top_topology_hwtcl.value"]
    	set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]

        switch $topology {
            "Gen5 1x16"    	{ set core_list [list "16"] }
            "Gen5 2x8"    	{ set core_list [list "16" "8"] }
            "Gen4 1x16"	    { set core_list [list "16"] }
            "Gen3 1x16"    	{ set core_list [list "16"] }
		    "Gen4 1x8"    	{ set core_list [list "16"] }
		    "Gen3 1x8"    	{ set core_list [list "16"] }
            "Gen4 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen3 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen5 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
            "Gen4 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
		    "Gen3 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
            "Gen5 1x8"      { set core_list [list "16"] }
            "Gen4 1x4"      { set core_list [list "16"] }
            "Gen4 2x4"      { set core_list [list "16" "8"] }
            "Gen3 1x4"      { set core_list [list "16"] }
            "Gen3 2x4"      { set core_list [list "16" "8"] }            
        }
        foreach core $core_list {
	ip_message info "Current $core_list"
		
            set_qhip_profile_param "core${core}_total_pf_count_hwtcl" 1 
            set_qhip_profile_param "core${core}_pf0_bar0_type_user_hwtcl" "64-bit prefetchable memory"  
            set_qhip_profile_param "core${core}_pf0_bar0_address_width_user_hwtcl" 16  
            set_qhip_profile_param "core${core}_maxpayload_size_hwtcl" 512 
            #Enable MSI to expose msi_pnd interface, disabled when virtio enabled
            set_qhip_profile_param "core${core}_virtual_pf0_msi_enable_user_hwtcl"  1  
            if {[regexp "Data Mover" $pcie_ss_func_mode_value]} {
                #PCIeSS MSIX Table will be overwritten QHIP MSIX TABLE in DM
                ip_set_param "parameter.core${core}_msix_en_table_hwtcl.value" 1
                ip_set_param "parameter.core${core}_msix_table_size_hwtcl.value" 4
                ip_set_param "parameter.core${core}_msix_bir_hwtcl.value" 5
                ip_set_param "parameter.core${core}_msix_bar_offset_hwtcl.value" 0
                ip_set_param "parameter.core${core}_msix_vector_alloc_hwtcl.value" "Static"
	            ip_set_param "parameter.core${core}_cpl_reordering_en_hwtcl.value" 1
                #ip_set_param "parameter.core${core}_device_att_en_hwtcl.value" 1
                set_qhip_profile_param "core${core}_virtual_pf0_msix_enable_user_hwtcl" 1
                if { $core == "8" } {
                    ip_set_param "parameter.core${core}_pf0_pci_msix_table_size_user_hwtcl.value" 3
                    #set_qhip_profile_param "core${core}_pf0_pci_msix_table_size_hwtcl" 3                    
                } else {
                    set_qhip_profile_param "core${core}_pf0_pci_msix_table_size_hwtcl" 3
                } 
                set_qhip_profile_param "core${core}_pf0_pci_msix_bir_hwtcl" 5
                set_qhip_profile_param "core${core}_pf0_pci_msix_pba_hwtcl" 5
                set_qhip_profile_param "core${core}_pf0_pci_msix_table_offset_hwtcl" 0
                set_qhip_profile_param "core${core}_pf0_pci_msix_pba_offset_hwtcl" [expr (0+(4*16)) >> 3]
            
            } else {
                #Power user mode cannot use PCIe SS MSIX, disable it and set to default value
                ip_set_param "parameter.core${core}_msix_en_table_hwtcl.value" 0
                ip_set_param "parameter.core${core}_msix_table_size_hwtcl.value" 1
                ip_set_param "parameter.core${core}_msix_bir_hwtcl.value" 5
                ip_set_param "parameter.core${core}_msix_bar_offset_hwtcl.value" 0
                ip_set_param "parameter.core${core}_msix_vector_alloc_hwtcl.value" "Static"
		        ip_set_param "parameter.core${core}_cpl_reordering_en_hwtcl.value" 0
                #ip_set_param "parameter.core${core}_device_att_en_hwtcl.value" 0
                
                #need set for QHIP
                set_qhip_profile_param "core${core}_virtual_pf0_msix_enable_user_hwtcl" 1
                if { $core == "8" } {
                    ip_set_param "parameter.core${core}_pf0_pci_msix_table_size_user_hwtcl.value" 3
                    #set_qhip_profile_param "core${core}_pf0_pci_msix_table_size_hwtcl" 3                    
                } else {
                    set_qhip_profile_param "core${core}_pf0_pci_msix_table_size_hwtcl" 3
                } 
                set_qhip_profile_param "core${core}_pf0_pci_msix_bir_hwtcl" 0
                set_qhip_profile_param "core${core}_pf0_pci_msix_pba_hwtcl" 0
                set_qhip_profile_param "core${core}_pf0_pci_msix_table_offset_hwtcl" 0
                set_qhip_profile_param "core${core}_pf0_pci_msix_pba_offset_hwtcl" 0              
            }
        }
    }

