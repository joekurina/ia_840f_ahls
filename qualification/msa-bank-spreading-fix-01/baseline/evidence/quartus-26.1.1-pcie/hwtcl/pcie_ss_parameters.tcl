       if {$topology =="Gen3 1x16" ||$topology =="Gen4 1x16"||$topology =="Gen3 1x8"||$topology=="Gen4 1x8" ||$topology =="Gen4 2x8"||$topology=="Gen3 2x8"||$topology =="Gen4 4x4"||$topology=="Gen3 4x4"} {
             ip_set_param "parameter.core16_axi_st_clk_freq_user_hwtcl.ENABLED" true
             ip_set_param "parameter.core8_axi_st_clk_freq_user_hwtcl.ENABLED" true
             ip_set_param "parameter.core4_0_axi_st_clk_freq_user_hwtcl.ENABLED" true
             ip_set_param "parameter.core4_1_axi_st_clk_freq_user_hwtcl.ENABLED" true
