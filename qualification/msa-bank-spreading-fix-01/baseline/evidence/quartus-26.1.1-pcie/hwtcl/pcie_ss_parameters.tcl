	proc ::intel_pcie_ss_axi::parameters::declare_parameters { {device_family "Stratix 10"} } {

    	# From ptile_common_param    
        variable pcie_link_parameters
        variable ss_profile_parameters
        # for {set i 0} {$i < 4} {incr i} {    
   	   variable top_parameters
   	# }
        variable core16_ss_opt_side_parameters
        variable core8_ss_opt_side_parameters
        variable core4_0_ss_opt_side_parameters
        variable core4_1_ss_opt_side_parameters          
        variable ss_interface_parameters
        #variable data_mover_features_parameters
        #variable msix_table_features_parameters
        variable addr_align_df_parameters 
        variable dfl_dfh_parameters
        #variable ss_diagnostics_parameters
        variable ss_mapped_integer_parameters
        variable ss_ceb_mapped_parameters
        variable qhip_parameters
        variable core16_parameters
        variable core8_parameters
        variable core4_0_parameters
        variable core4_1_parameters
        #From ptile_ast_param
        variable core16_avst_parameters
        variable core8_avst_parameters
        variable core4_0_avst_parameters
        variable core4_1_avst_parameters
        variable bar_size_parameters
        variable display_items
        variable pcie_ss_items
        variable ptile_avst_display_items
        variable use_lampas_solver
        variable example_design_parameters
        
        # From ptile_common_param
#        ip_declare_parameters $top_parameters
        # ip_declare_parameters $top_parameters1
        # ip_declare_parameters $top_parameters2
        # ip_declare_parameters $top_parameters3
        ip_declare_parameters $ss_profile_parameters
        ip_declare_parameters $core16_ss_opt_side_parameters
        ip_declare_parameters $core8_ss_opt_side_parameters
        ip_declare_parameters $core4_0_ss_opt_side_parameters
        ip_declare_parameters $core4_1_ss_opt_side_parameters   
        ip_declare_parameters $pcie_link_parameters
        ip_declare_parameters $ss_interface_parameters
        #ip_declare_parameters $data_mover_features_parameters
        #ip_declare_parameters $msix_table_features_parameters
        ip_declare_parameters $addr_align_df_parameters 
        ip_declare_parameters $dfl_dfh_parameters
        #ip_declare_parameters $ss_diagnostics_parameters
        ip_declare_parameters $ss_mapped_integer_parameters
        ip_declare_parameters $ss_ceb_mapped_parameters
        ip_declare_parameters $qhip_parameters
        ip_declare_parameters $core16_parameters
        ip_declare_parameters $core8_parameters
        ip_declare_parameters $core4_0_parameters
        ip_declare_parameters $core4_1_parameters
        #From ptile_ast_param
        ip_declare_parameters $core16_avst_parameters
        ip_declare_parameters $core8_avst_parameters
        ip_declare_parameters $core4_0_avst_parameters
        ip_declare_parameters $core4_1_avst_parameters
        ip_declare_parameters $bar_size_parameters
        ip_declare_parameters $example_design_parameters

        #Add common parameters
        #common parameters among cores
       #vww19 debug  
        foreach core [list "16" "8" "4_0" "4_1"] {
            ip_declare_parameters [get_pciesys_parameters $core]
            ip_declare_parameters [get_bar_parameters $core]            
            ip_declare_parameters [get_cap_parameters $core]
            ip_declare_parameters [get_identification_parameters $core]
            ip_declare_parameters [get_vsec_parameters $core]
            ip_declare_parameters [get_soft_ip_parameters $core]
        }
        foreach core [list "16" "8"] {
            ip_declare_parameters [get_sriov_parameters $core]
            ip_declare_parameters [get_ats_tph_parameters $core]
            ip_declare_parameters [get_virtio_parameters $core]
        }

        #hide qhip parameter from the top of the pcie_ss
        
        foreach core [list "16" "8" "4_0" "4_1"] {
             set_qhip_hdl_param [get_pciesys_parameters $core]
             set_qhip_hdl_param [get_cap_parameters $core]
             set_qhip_hdl_param [get_identification_parameters $core]
             set_qhip_hdl_param [get_vsec_parameters $core]
             set_qhip_hdl_param [get_soft_ip_parameters $core]
        }
        foreach core [list "16" "8"] {
             #set_qhip_hdl_param [get_bar_parameters $core]
             set_qhip_hdl_param [get_sriov_parameters $core]
             set_qhip_hdl_param [get_ats_tph_parameters $core]
             set_qhip_hdl_param [get_virtio_parameters $core]
        }
        
        #export qhip parameter based on the top of the pcie_ss
        _export_param_list
        #set_qhip_hdl_param $core16_avst_parameters
        #set_qhip_hdl_param $core8_avst_parameters
        #set_qhip_hdl_param $core4_0_avst_parameters
        #set_qhip_hdl_param $core4_1_avst_parameters
                   
        
        foreach core [list "16" "8"] {
            ip_declare_parameters [get_mapped_integer_parameters $core]
            ip_declare_parameters [get_qhip_mapped_parameters $core]
        }

        # Must declare last because VISIBLE and ENABLE are contolled here
        ip_declare_parameters $top_parameters
     
        # Add display items
        ip_declare_display_items $display_items
        ip_declare_display_items $pcie_ss_items
        ip_declare_display_items $ptile_avst_display_items
        ## Initialize device information (to allow sharing of this function across device families)
        ip_set_param "parameter.device_family.SYSTEM_INFO" DEVICE_FAMILY
        ip_set_param "parameter.device_family.DEFAULT_VALUE" $device_family

        ## Pass down base_device
        ip_set_param "parameter.base_device.SYSTEM_INFO_TYPE" PART_TRAIT
        ip_set_param "parameter.base_device.SYSTEM_INFO_ARG"  BASE_DEVICE

        ## Pass down part_trait_device
        ip_set_param "parameter.part_trait_device.SYSTEM_INFO_TYPE" PART_TRAIT
        ip_set_param "parameter.part_trait_device.SYSTEM_INFO_ARG"  DEVICE

        # Pass down speed_grade
        ip_set_param "parameter.speed_grade.SYSTEM_INFO" DEVICE_SPEEDGRADE

        ## Pass down design_environment
        #ip_set_param "parameter.design_environment.SYSTEM_INFO" DESIGN_ENVIRONMENT
        ## Pass down device
        ip_set_param "parameter.device.SYSTEM_INFO" DEVICE

        ## Pass down device_die_types and device_die_revisions
        ip_set_param "parameter.device_die_types.SYSTEM_INFO_TYPE" DEVICE_DIE_TYPES
        ip_set_param "parameter.device_die_revisions.SYSTEM_INFO_TYPE" DEVICE_DIE_REVISIONS
       
        #Parameter callback set back to default
        #Callback from QHIP
        set_parameter_update_callback "top_topology_hwtcl" ::intel_pcie_ss_axi::parameters::top_topology_hwtcl_reset_default
        set_parameter_update_callback "virtual_tlp_bypass_en_user_hwtcl" ::intel_pcie_ss_axi::parameters::virtual_tlp_bypass_en_user_hwtcl_reset_port_mode
        set_parameter_update_callback "virtual_rp_ep_mode_hwtcl" ::intel_pcie_ss_axi::parameters::virtual_rp_ep_mode_default
        set_parameter_update_callback "core16_enable_multi_func_hwtcl" ::intel_pcie_ss_axi::parameters::core16_enable_multi_func_hwtcl_reset_default
        set_parameter_update_callback "core8_enable_multi_func_hwtcl" ::intel_pcie_ss_axi::parameters::core8_enable_multi_func_hwtcl_reset_default
        set_parameter_update_callback "core4_0_enable_multi_func_hwtcl" ::intel_pcie_ss_axi::parameters::core4_0_enable_multi_func_hwtcl_reset_default
        set_parameter_update_callback "core4_1_enable_multi_func_hwtcl" ::intel_pcie_ss_axi::parameters::core4_1_enable_multi_func_hwtcl_reset_default        
        set_parameter_update_callback "core16_total_pf_count_hwtcl" ::intel_pcie_ss_axi::parameters::core16_total_pf_count_hwtcl_reset_default
        set_parameter_update_callback "core8_total_pf_count_hwtcl" ::intel_pcie_ss_axi::parameters::core8_total_pf_count_hwtcl_reset_default
