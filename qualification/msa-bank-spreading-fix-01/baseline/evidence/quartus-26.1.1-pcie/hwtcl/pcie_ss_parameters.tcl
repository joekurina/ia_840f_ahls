     proc ::intel_pcie_ss_axi::parameters::set_core16_pci_msix_param {} {
            #params:
            #core16_pf${a}_pci_msix_table_offset_hwtcl "pf0 - pf7"
            #core16_pf${a}_pci_msix_pba_offset_hwtcl "pf0 - pf7"
            #core16_exvf_msixtable_offset_pf${a} "pf0 - pf7"
            #core16_exvf_msixpba_offset_pf${a} "pf0 - pf7"
            set exvf_param {{core16_exvf_msixtable_offset_pf} {core16_exvf_msixpba_offset_pf}}
        set tile [ip_get "parameter.TILE.value"]
        if {$tile == "P-TILE"} {
            for {set a 0} {$a < 8} {incr a} {
                set pci_msix_param "core16_pf${a}_pci_msix_table_offset_hwtcl"
                set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:4294967295}
            }

            for {set a 0} {$a < 8} {incr a} {
                set pci_msix_param "core16_pf${a}_pci_msix_pba_offset_hwtcl"
                set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:4294967295}
            }

            foreach param $exvf_param {
                for {set a 0} {$a < 8} {incr a} {
                    set exvf_msix_param $param$a
                    set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:4294967295}
                }
            }
        } elseif {$tile == "F-TILE" ||$tile =="R-TILE"} {

            for {set a 0} {$a < 8} {incr a} {
                set pci_msix_param "core16_pf${a}_pci_msix_table_offset_hwtcl"
                set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:536870911}
            }

            for {set a 0} {$a < 8} {incr a} {
                set pci_msix_param "core16_pf${a}_pci_msix_pba_offset_hwtcl"
                set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:536870911}
            }

            foreach param $exvf_param {
                for {set a 0} {$a < 8} {incr a} {
                    set exvf_msix_param $param$a
                    set_parameter_property $pci_msix_param "ALLOWED_RANGES" {0:536870911}
                }
            }

        }
     }


