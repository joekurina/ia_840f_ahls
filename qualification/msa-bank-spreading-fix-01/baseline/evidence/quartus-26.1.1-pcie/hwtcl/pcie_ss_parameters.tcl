            ip_set_param "parameter.pciess_topology.value"  "pcie_x8"
            ip_set_param "parameter.pciess_topology_integer_hwtcl.value" 0
        } elseif { [regexp "2x8" $top_topology_hwtcl] } {
            ip_set_param "parameter.pciess_topology.value"  "pcie_x8x8"
            ip_set_param "parameter.pciess_topology_integer_hwtcl.value" 1
        } elseif { [regexp "4x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.pciess_topology.value"  "pcie_x4x4x4x4"
            ip_set_param "parameter.pciess_topology_integer_hwtcl.value" 2
        } elseif { [regexp "1x4" $top_topology_hwtcl] } {
            ip_set_param "parameter.pciess_topology.value"  "pcie_x4"
            ip_set_param "parameter.pciess_topology_integer_hwtcl.value" 0
