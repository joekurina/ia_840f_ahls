            if  {[regexp "Gen3x16, Interface - 256 bit" $top_topology_hwtcl] } {
                ip_set_param "parameter.core16_en_512s_to_256s_adp_hwtcl.value" 1
            } else {
                ip_set_param "parameter.core16_en_512s_to_256s_adp_hwtcl.value" 0
            }
        
        }
