    proc ::intel_pcie_ss_axi::parameters::validate_ceb_en_hwtcl { PROP_NAME PROP_VALUE } {
       set tile                 [ip_get "parameter.TILE.value"]
       set core16_ceb_en_hwtcl  [ip_get "parameter.core16_ceb_en_hwtcl.value"]
       set core8_ceb_en_hwtcl   [ip_get "parameter.core8_ceb_en_hwtcl.value"]
       set core4_0_ceb_en_hwtcl [ip_get "parameter.core4_0_ceb_en_hwtcl.value"]
       set core4_1_ceb_en_hwtcl [ip_get "parameter.core4_1_ceb_en_hwtcl.value"]
       set core16_enable_virtio  [ip_get "parameter.core16_enable_virtio_hwtcl.value"]
       set core8_enable_virtio   [ip_get "parameter.core8_enable_virtio_hwtcl.value"]
       set core4_0_enable_virtio [ip_get "parameter.core4_0_enable_virtio_hwtcl.value"]
       set core4_1_enable_virtio [ip_get "parameter.core4_1_enable_virtio_hwtcl.value"]

       if {$core16_ceb_en_hwtcl} {
           ip_set_param "parameter.core16_cii_en_hwtcl.ENABLED" false
       } else {
           ip_set_param "parameter.core16_cii_en_hwtcl.ENABLED" true
       } 
       if {$core8_ceb_en_hwtcl} {
           ip_set_param "parameter.core8_cii_en_hwtcl.ENABLED" false
       } else {
           ip_set_param "parameter.core8_cii_en_hwtcl.ENABLED" true
       } 
       if {$core4_0_ceb_en_hwtcl} {
           ip_set_param "parameter.core4_0_cii_en_hwtcl.ENABLED" false
       } else {
           ip_set_param "parameter.core4_0_cii_en_hwtcl.ENABLED" true
       } 
       if {$core4_1_ceb_en_hwtcl} {
           ip_set_param "parameter.core4_1_cii_en_hwtcl.ENABLED" false
       } else {
           ip_set_param "parameter.core4_1_cii_en_hwtcl.ENABLED" true
       } 
    
       set core16_ceb_pf_std_cap_last_ptr_value   [ip_get "parameter.core16_ceb_pf_std_cap_last_ptr_hwtcl.value"]
       set core16_ceb_vf_std_cap_last_ptr_value   [ip_get "parameter.core16_ceb_vf_std_cap_last_ptr_hwtcl.value"]
       set core8_ceb_pf_std_cap_last_ptr_value    [ip_get "parameter.core8_ceb_pf_std_cap_last_ptr_hwtcl.value"]
       set core8_ceb_vf_std_cap_last_ptr_value    [ip_get "parameter.core8_ceb_vf_std_cap_last_ptr_hwtcl.value"]
       set core4_0_ceb_pf_std_cap_last_ptr_value  [ip_get "parameter.core4_0_ceb_pf_std_cap_last_ptr_hwtcl.value"]
       set core4_0_ceb_vf_std_cap_last_ptr_value  [ip_get "parameter.core4_0_ceb_vf_std_cap_last_ptr_hwtcl.value"]
       set core4_1_ceb_pf_std_cap_last_ptr_value  [ip_get "parameter.core4_1_ceb_pf_std_cap_last_ptr_hwtcl.value"]
       set core4_1_ceb_vf_std_cap_last_ptr_value  [ip_get "parameter.core4_1_ceb_vf_std_cap_last_ptr_hwtcl.value"]

       set core16_ceb_pf_std_cap_last_ptr_hwtcl   [expr $core16_ceb_pf_std_cap_last_ptr_value  * 4]
       set core16_ceb_vf_std_cap_last_ptr_hwtcl   [expr $core16_ceb_vf_std_cap_last_ptr_value  * 4]
       set core8_ceb_pf_std_cap_last_ptr_hwtcl    [expr $core8_ceb_pf_std_cap_last_ptr_value   * 4]
       set core8_ceb_vf_std_cap_last_ptr_hwtcl    [expr $core8_ceb_vf_std_cap_last_ptr_value   * 4]
       set core4_0_ceb_pf_std_cap_last_ptr_hwtcl  [expr $core4_0_ceb_pf_std_cap_last_ptr_value * 4]
       set core4_0_ceb_vf_std_cap_last_ptr_hwtcl  [expr $core4_0_ceb_vf_std_cap_last_ptr_value * 4]
       set core4_1_ceb_pf_std_cap_last_ptr_hwtcl  [expr $core4_1_ceb_pf_std_cap_last_ptr_value * 4]
       set core4_1_ceb_vf_std_cap_last_ptr_hwtcl  [expr $core4_1_ceb_vf_std_cap_last_ptr_value * 4]

        if {[regexp "core16" $PROP_NAME]} {
            if {$PROP_VALUE && $core16_enable_virtio } {
                ip_set_param "parameter.core16_ceb_enable_hwtcl.value" 1
                ip_set_param "parameter.core16_pf_ceb_pointer_addr_user_hwtcl.value" $core16_ceb_pf_std_cap_last_ptr_hwtcl
                ip_set_param "parameter.core16_vf_ceb_pointer_addr_user_hwtcl.value" $core16_ceb_vf_std_cap_last_ptr_hwtcl
            } else {
                ip_set_param "parameter.core16_ceb_enable_hwtcl.value" 0
                ip_set_param "parameter.core16_pf_ceb_pointer_addr_user_hwtcl.value" 0
                ip_set_param "parameter.core16_vf_ceb_pointer_addr_user_hwtcl.value" 0
            }
            
            set_qhip_param "core16_ceb_enable_hwtcl" [ip_get "parameter.core16_ceb_enable_hwtcl.value"]
            set_qhip_param "core16_pf_ceb_pointer_addr_user_hwtcl" [ip_get "parameter.core16_pf_ceb_pointer_addr_user_hwtcl.value"]
            set_qhip_param "core16_vf_ceb_pointer_addr_user_hwtcl" [ip_get "parameter.core16_vf_ceb_pointer_addr_user_hwtcl.value"]

        }

        if {[regexp "core8" $PROP_NAME]} {
            if {$PROP_VALUE && $core8_enable_virtio } {
                ip_set_param "parameter.core8_ceb_enable_hwtcl.value" 1
                ip_set_param "parameter.core8_pf_ceb_pointer_addr_user_hwtcl.value" $core8_ceb_pf_std_cap_last_ptr_hwtcl
                ip_set_param "parameter.core8_vf_ceb_pointer_addr_user_hwtcl.value" $core8_ceb_vf_std_cap_last_ptr_hwtcl
            } else {
                ip_set_param "parameter.core8_ceb_enable_hwtcl.value" 0
                ip_set_param "parameter.core8_pf_ceb_pointer_addr_user_hwtcl.value" 0
                ip_set_param "parameter.core8_vf_ceb_pointer_addr_user_hwtcl.value" 0
            }
            set_qhip_param "core8_ceb_enable_hwtcl" [ip_get "parameter.core8_ceb_enable_hwtcl.value"]
            set_qhip_param "core8_pf_ceb_pointer_addr_user_hwtcl" [ip_get "parameter.core8_pf_ceb_pointer_addr_user_hwtcl.value"]
            set_qhip_param "core8_vf_ceb_pointer_addr_user_hwtcl" [ip_get "parameter.core8_vf_ceb_pointer_addr_user_hwtcl.value"]
        }

       if {[regexp "core4_0" $PROP_NAME] && $tile =="R-TILE"} {
           set_qhip_param "core4_0_ceb_enable_hwtcl" $core4_0_ceb_en_hwtcl 
           if {$PROP_VALUE && $core4_0_enable_virtio } {
               set_qhip_param "core4_0_pf_ceb_pointer_addr_user_hwtcl" $core4_0_ceb_pf_std_cap_last_ptr_hwtcl
               set_qhip_param "core4_0_vf_ceb_pointer_addr_user_hwtcl" $core4_0_ceb_vf_std_cap_last_ptr_hwtcl 
           } else {
               set_qhip_param "core4_0_pf_ceb_pointer_addr_user_hwtcl" 0 
               set_qhip_param "core4_0_vf_ceb_pointer_addr_user_hwtcl" 0  
           }
       }

       if {[regexp "core4_1" $PROP_NAME] && $tile =="R-TILE"} {
           set_qhip_param "core4_1_ceb_enable_hwtcl" $core4_1_ceb_en_hwtcl 
           if {$PROP_VALUE && $core4_1_enable_virtio } {
               set_qhip_param "core4_1_pf_ceb_pointer_addr_user_hwtcl" $core4_1_ceb_pf_std_cap_last_ptr_hwtcl
               set_qhip_param "core4_1_vf_ceb_pointer_addr_user_hwtcl" $core4_1_ceb_vf_std_cap_last_ptr_hwtcl 
           } else {
               set_qhip_param "core4_1_pf_ceb_pointer_addr_user_hwtcl" 0 
               set_qhip_param "core4_1_vf_ceb_pointer_addr_user_hwtcl" 0  
           }
       }

       if {$tile == "F-TILE"} {
          set topology           [ip_get "parameter.top_topology_hwtcl.value"]
          if { [regexp "1x4" $topology] } {
             ip_set_param "parameter.core16_ceb_en_hwtcl.VISIBLE" false
          }
       }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_dfl_en_hwtcl { PROP_NAME PROP_VALUE } {

        ## if value ==0x00, enable vsec, next offset = CEB 
        set core16_vsec_cap [ip_get "parameter.core16_user_vsec_cap_enable_hwtcl.value"]
        set core8_vsec_cap [ip_get "parameter.core8_user_vsec_cap_enable_hwtcl.value"]
        set core4_0_vsec_cap [ip_get "parameter.core4_0_user_vsec_cap_enable_hwtcl.value"]
        set core4_1_vsec_cap [ip_get "parameter.core4_1_user_vsec_cap_enable_hwtcl.value"]

        set core16_enable_ceb_ss [ip_get "parameter.core16_ceb_en_hwtcl.value"]
        set core8_enable_ceb_ss [ip_get "parameter.core8_ceb_en_hwtcl.value"]
        set core4_0_enable_ceb_ss [ip_get "parameter.core4_0_ceb_en_hwtcl.value"]
        set core4_1_enable_ceb_ss [ip_get "parameter.core4_1_ceb_en_hwtcl.value"]

        set core16_enable_dfl [ip_get "parameter.core16_dfl_en_hwtcl.value"]
        set core8_enable_dfl  [ip_get "parameter.core8_dfl_en_hwtcl.value"]
        set core4_0_enable_dfl [ip_get "parameter.core4_0_dfl_en_hwtcl.value"]
        set core4_1_enable_dfl  [ip_get "parameter.core4_1_dfl_en_hwtcl.value"] 

        set core16_enable_cii [ip_get "parameter.core16_cii_en_hwtcl.value"]
        set core8_enable_cii  [ip_get "parameter.core8_cii_en_hwtcl.value"]
        set core4_0_enable_cii [ip_get "parameter.core4_0_cii_en_hwtcl.value"]
        set core4_1_enable_cii  [ip_get "parameter.core4_1_cii_en_hwtcl.value"]

        set core16_ceb_pf_ext_cap_last_ptr_value    [ip_get "parameter.core16_ceb_pf_ext_cap_last_ptr_hwtcl.value"]
        set core8_ceb_pf_ext_cap_last_ptr_value    [ip_get "parameter.core8_ceb_pf_ext_cap_last_ptr_hwtcl.value"]
        set core4_0_ceb_pf_ext_cap_last_ptr_value    [ip_get "parameter.core4_0_ceb_pf_ext_cap_last_ptr_hwtcl.value"]
        set core4_1_ceb_pf_ext_cap_last_ptr_value    [ip_get "parameter.core4_1_ceb_pf_ext_cap_last_ptr_hwtcl.value"]

        set core16_ceb_pf_ext_cap_last_ptr_hwtcl    [expr $core16_ceb_pf_ext_cap_last_ptr_value * 4]
        set core8_ceb_pf_ext_cap_last_ptr_hwtcl     [expr $core8_ceb_pf_ext_cap_last_ptr_value * 4]
        set core4_0_ceb_pf_ext_cap_last_ptr_hwtcl    [expr $core4_0_ceb_pf_ext_cap_last_ptr_value * 4]
        set core4_1_ceb_pf_ext_cap_last_ptr_hwtcl     [expr $core4_1_ceb_pf_ext_cap_last_ptr_value * 4]

        #ip_set_param "parameter.core16_ceb_pf_ext_cap_last_ptr_hwtcl.ALLOWED_RANGES" {0 64:1023}
        #ip_set_param "parameter.core8_ceb_pf_ext_cap_last_ptr_hwtcl.ALLOWED_RANGES" {0 64:1023}
        if {[regexp "core16" $PROP_NAME]} {
            if {$PROP_VALUE} {
                # CEB TURN OFF # DFL ON
                if {!$core16_enable_ceb_ss} {
                    ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 1
                    ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" 3420
                    ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" 0
                    for {set i 1} { $i < 8 } {incr i} {
                        set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                        if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                            #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                            ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                        } else {
                            ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                        }
                    }
                } else {
                    # CEB TURN ON # DFL ON
                    if {$core16_ceb_pf_ext_cap_last_ptr_hwtcl == 0} {
                        ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 1
                        ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" 3420
                        ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" 0
                        for {set i 1} { $i < 8 } {incr i} {
                            set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                            } else {
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                    } else {
                        ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 1
                        ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" 3420
                        ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                        # Range of ceb_ext must not input with current range from D5C to E64 changed to bit address which is 357 to 399
                        #ip_set_param "parameter.core16_ceb_pf_ext_cap_last_ptr_hwtcl.ALLOWED_RANGES" {0 64:854 921:1023}
                        if { ($core16_ceb_pf_ext_cap_last_ptr_hwtcl >= 855 ) && ($core16_ceb_pf_ext_cap_last_ptr_hwtcl <= 921 )} {
                        	ip_message error "When CEB and DFL features are enabled, PCIe0 Extended next address pointer for PF from 0x357 to 0x399 are not available to used by CEB "
                        }
                        for {set i 1} { $i < 8 } {incr i} {
                            set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                            } else {
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                    }
                }
            } else {
                if {!$core16_enable_ceb_ss} {
                # CEB TURN OFF # DFL OFF
                    ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 0
                    ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" 0
                    ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" 0
                    for {set i 1} { $i < 8 } {incr i} {
                        set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                        if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                            #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                            ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                        } else {
                            ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                        }
                    }
                } else {
                    # CEB TURN ON # DFL OFF
                    if {$core16_ceb_pf_ext_cap_last_ptr_hwtcl == 0} {
                        ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 0
                        ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" 0
                        ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" 0
                        for {set i 1} { $i < 8 } {incr i} {
                            set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            } else {
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                    } else {
                        ip_set_param "parameter.core16_user_vsec_cap_enable_hwtcl.value" 1
                        ip_set_param "parameter.core16_vsec_next_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                        ip_set_param "parameter.core16_dfl_next_cap_offset_hwtcl.value" 0
                       set tile [ip_get "parameter.TILE.value"]
                       if {$tile =="P-TILE" ||$tile =="F-TILE"} {  
                        for {set i 1} { $i < 8 } {incr i} {
                            set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                                } else {
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }
                      } else {
                         for {set i 0} { $i < 8 } {incr i} {
                            set core16_virtual_pfi_enable_hwtcl [ip_get "parameter.core16_virtual_pf${i}_enable_hwtcl.value"]
                            if { ${core16_virtual_pfi_enable_hwtcl} == 1 } {
                                #CEB turn off, so pf1 -> pf7 dont have DFL and the offset will be set to 0
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" $core16_ceb_pf_ext_cap_last_ptr_hwtcl
                                } else {
                                ip_set_param "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value" 0
                            }
                        }

                      }
                    }
                }
            }
            set_qhip_param "core16_user_vsec_cap_enable_hwtcl" [ip_get "parameter.core16_user_vsec_cap_enable_hwtcl.value"]
            set_qhip_param "core16_vsec_next_offset_hwtcl" [ip_get "parameter.core16_vsec_next_offset_hwtcl.value"]
            for {set i 1} { $i < 8 } {incr i} {
                set_qhip_param "core16_virtual_pf${i}_user_vsec_offset_hwtcl" [ip_get "parameter.core16_virtual_pf${i}_user_vsec_offset_hwtcl.value"]
            }
            if {$core16_enable_dfl && ($core16_enable_ceb_ss ==0 && $core16_enable_cii==0)} {
               ip_message error "Enable PCIe0 Configuration Extension Bus Interface needs to be selected if Enable PCIe0 DFL VSEC Capability is selected"
            }    
            #set core16_vsec_cap [ip_get "parameter.core16_vsec_next_offset_hwtcl.value"]
            #puts "Debug: core16_vsec_next_offset_hwtcl -- $core16_vsec_cap "
            #set core16_vsec_cap_qhip [get_qhip_param_value "core16_vsec_next_offset_hwtcl"]
            #puts "Debug_qhip: core16_vsec_next_offset_hwtcl_qhip -- $core16_vsec_cap_qhip "

            #set core16_virtual_pf1_user_vsec_offset_hwtcl_qhip [get_qhip_param_value "core16_virtual_pf1_user_vsec_offset_hwtcl"]
            #set core16_virtual_pf2_user_vsec_offset_hwtcl_qhip [get_qhip_param_value "core16_virtual_pf2_user_vsec_offset_hwtcl"]
            #set core16_virtual_pf3_user_vsec_offset_hwtcl_qhip [get_qhip_param_value "core16_virtual_pf3_user_vsec_offset_hwtcl"]
            #set core16_virtual_pf4_user_vsec_offset_hwtcl_qhip [get_qhip_param_value "core16_virtual_pf4_user_vsec_offset_hwtcl"]
