	if {[regexp "bar01" $PROP_NAME]} {
		set bar_a 0
		set bar_b 1
	} elseif {[regexp "bar23" $PROP_NAME]} {
		set bar_a 2
		set bar_b 3		
	} else {
		set bar_a 4
		set bar_b 5	
	}

	if {$core16_func_mode_hwtcl == "Disable"} {
		for {set i 0} {$i < 8} {incr i} {
			ip_set_param "parameter.core16_pf${i}_bar${bar_a}${bar_b}_size_mask.value" 0
		}
    } else {
    	for {set i 0} {$i < 8} {incr i} {
    	   set pf_bar_name "core16_pf${i}_bar${bar_a}_type_hwtcl"
   	   	   set bar_type [ip_get "parameter.$pf_bar_name.value"]
   	   	   
   	   	   set bara_size [ip_get "parameter.core16_pf${i}_bar${bar_a}_address_width_hwtcl.value"]
   	   	   set barb_size [ip_get "parameter.core16_pf${i}_bar${bar_b}_address_width_hwtcl.value"]
        	
   	   	   set bara_size_mask31_0 0
   	   	   set barb_size_mask31_0 0
   	   	   
   	   	   if {[regexp "64-bit" $bar_type]} {
   	   	   	   if {$bara_size == 64} {
   	   	   	   	   set barab_size_mask64	[expr {~0}]   	   	   	   
   	   	   	   } else {
   	   	   	   	   set barab_size_mask64	[expr {~( ~0 << $bara_size)}]
   	   	   	   }
   	   	   	   set get_bar_size_mask $barab_size_mask64
   	   	   } else {
   	   	   	   #4294967295 represent 64'hFFFF_FFFF, need to set with decimal number since tcl not able to set the binary width
   	   	   	   set bara_size_mask31_0  	[expr {~(4294967295 << $bara_size) & 4294967295 }]
   	   	   	   set barb_size_mask31_0 	[expr {(~(4294967295 << $barb_size) & 4294967295) << 32}]
   	   	   	   set get_bar_size_mask 	[expr {$barb_size_mask31_0 | $bara_size_mask31_0}]
   	   	   }
   	   	   ip_set_param "parameter.core16_pf${i}_bar${bar_a}${bar_b}_size_mask.value" $get_bar_size_mask
   	   }
   	    
    }
   }

