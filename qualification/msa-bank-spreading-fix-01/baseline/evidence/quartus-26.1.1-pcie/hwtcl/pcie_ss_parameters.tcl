    proc ::intel_pcie_ss_axi::parameters::validate_non_rbc_rules {} {
        # loop through cores 16 and 8 as only these two cores require PF/VF BAR checks
        foreach core_num [list "16" "8"] {
            # pcie_num mappings:
                # core16 -> 0
                # core8 -> 1
            if {$core_num == "16"} {
                set pcie_num 0
            } elseif {$core_num == "8"} {
                set pcie_num 1
            }

            # get PF count
            set core_total_pf_count_hwtcl($pcie_num) [ip_get "parameter.core${core_num}_total_pf_count_hwtcl.value"]
            # get port mode
            set core_virtual_rp_ep_mode_integer_hwtcl($pcie_num) [ip_get "parameter.core${core_num}_virtual_rp_ep_mode_integer_hwtcl.value"]
            # get core 8 or 16 enable
            set core_func_mode_hwtcl($pcie_num) [ip_get "parameter.core${core_num}_func_mode_hwtcl.value"]

            # If core 8 OR 16 IS enabled and native endpoint mode
            if { $core_func_mode_hwtcl($pcie_num) == "Enable" && $core_virtual_rp_ep_mode_integer_hwtcl($pcie_num) == 0 } {
                # PF 0-7
                for {set pf 0} {$pf < $core_total_pf_count_hwtcl($pcie_num)} {incr pf 1} {
                    # bars 0-5
                    set pf_no_bar_enabled($pcie_num) 1
                    for {set i 0} {$i <= 5} {incr i 1} {
                        set core_pf_bar_type_integer_hwtcl($pcie_num,$pf,$i) [ip_get "parameter.core${core_num}_pf${pf}_bar${i}_type_integer_hwtcl.value"]
                        set core_pf_bar_address_width_hwtcl($pcie_num,$pf,$i) [ip_get "parameter.core${core_num}_pf${pf}_bar${i}_address_width_hwtcl.value"]
                        if { $core_pf_bar_type_integer_hwtcl($pcie_num,$pf,$i) } {
                            set pf_no_bar_enabled($pcie_num) 0
                            if { $core_pf_bar_address_width_hwtcl($pcie_num,$pf,$i) == 0 } {
                                ip_message error "PF${pf} PCIe${pcie_num} BAR Configuration: The value of parameter <b>\"BAR$i Size\"</b> cannot be set to <b>\"N/A\"</b> if <b>\"BAR$i Type\"</b> is not <b>\"Disabled\"</b>"
                            }
                        }
                    }
                    if { $pf_no_bar_enabled($pcie_num) } {
                        ip_message error "When PF${pf} is enabled for PCIe${pcie_num}, it must have at least one enabled <b>\"Base Address Register\"</b>."
                    }
                }

                # VFs

                # get multi_func and sriov settings
                set core_enable_multi_func_hwtcl($pcie_num) [ip_get "parameter.core${core_num}_enable_multi_func_hwtcl.value"]
                set core_enable_sriov_hwtcl($pcie_num) [ip_get "parameter.core${core_num}_enable_sriov_hwtcl.value"]

                # Check that virtual functions are enabled
                if { $core_enable_multi_func_hwtcl($pcie_num) == 1 && $core_enable_sriov_hwtcl($pcie_num) == 1} {
                    # VF 0-7
                    for {set vf 0} {$vf < $core_total_pf_count_hwtcl($pcie_num)} {incr vf 1} {
                        # bars 0-5
                        set core_pf_vf_count_hwtcl($pcie_num,$vf) [ip_get "parameter.core${core_num}_pf${vf}_vf_count_hwtcl.value"]

                        if { $core_pf_vf_count_hwtcl($pcie_num,$vf) > 0} {
                            set vf_no_bar_enabled($pcie_num) 1
                            for {set i 0} {$i <= 5} {incr i 1} {
                             set tile [ip_get "parameter.TILE.value"]
                               if {$tile =="P-TILE" || $tile =="F-TILE"} {
                                   set core_vf_bar_type_integer_hwtcl($pcie_num,$vf,$i) [ip_get "parameter.core${core_num}_pf${vf}_sriov_vf_bar${i}_type_integer_hwtcl.value"]
                               } elseif {$tile == "R-TILE"} {
                                         set core_vf_bar_type_integer_hwtcl($pcie_num,$vf,$i) [ip_get "parameter.core${core_num}_pf${vf}_sriov_vf_bar${i}_type_integer_hwtcl_r.value"]
                               }
                               
                                set core_vf_bar_address_width_hwtcl($pcie_num,$vf,$i) [ip_get "parameter.core${core_num}_pf${vf}_sriov_vf_bar${i}_address_width_hwtcl.value"]
                                if { $core_vf_bar_type_integer_hwtcl($pcie_num,$vf,$i) } {
                                    set vf_no_bar_enabled($pcie_num) 0
                                    if { $core_vf_bar_address_width_hwtcl($pcie_num,$vf,$i) == 0 } {
                                        ip_message error "PF${vf} VF PCIe${pcie_num} BAR Configuration: The value of parameter <b>\"BAR$i Size\"</b> cannot be set to <b>\"N/A\"</b> if <b>\"BAR$i Type\"</b> is not <b>\"Disabled\"</b>"
                                    }
                                }
                            }
                            
                            if { $vf_no_bar_enabled($pcie_num) } {
                                ip_message error "When VF count is greater than 0 for PF${vf} VF PCIe${pcie_num}, it must have at least one enabled <b>\"Base Address Register\"</b>."
                            }
                        }
                    }
                }
            }
        }
    }
    
    proc ::intel_pcie_ss_axi::parameters::validate_pciess_msix {} {
        set topology [ip_get "parameter.top_topology_hwtcl.value"]
        set core16_total_pf_count_hwtcl [ip_get "parameter.core16_total_pf_count_hwtcl.value"]
        set core8_total_pf_count_hwtcl [ip_get "parameter.core8_total_pf_count_hwtcl.value"]


        switch $topology {
            "Gen5 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen5 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
            "Gen4 1x16"	    { set core_list [list "16"] }
            "Gen3 1x16"    	{ set core_list [list "16"] }
		    "Gen4 1x8"    	{ set core_list [list "16"] }
		    "Gen3 1x8"    	{ set core_list [list "16"] }
            "Gen4 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen3 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen4 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
		    "Gen3 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }	
        }
        #MSIX Validation In Data Mover Mode only
        # For Static
        foreach core $core_list {

            switch $core {
                16	    { set total_pf_count_hwtcl [ip_get "parameter.core16_total_pf_count_hwtcl.value"] }
                8    	{ set total_pf_count_hwtcl [ip_get "parameter.core8_total_pf_count_hwtcl.value"] }
            }
            if {[get_parameter_value core${core}_msix_en_table_hwtcl]} {
                   
                    #MSIX Table Size Check
                    #SS MSIX Table SIZE == QHIP PF/VF MSIX TABLE SIZE
                    #SS MSIX BIR == QHIP PF/VF MSIX/PBA BIR
                    #SS MSIX Offset == QHIP PF/VF MSIX/PBA OFFSET
                    for { set i 0 } { $i < $total_pf_count_hwtcl } { incr i } {
                        #PF
                        if { [get_parameter_value core${core}_virtual_pf${i}_enable_hwtcl] } {
                            if {[get_parameter_value core${core}_virtual_pf${i}_msix_enable_user_hwtcl]} {
                                
                                compare_parameters_value core${core}_msix_table_size_hwtcl  core${core}_pf${i}_pci_msix_table_size_hwtcl

                                compare_parameters_value core${core}_msix_bir_hwtcl         core${core}_pf${i}_pci_msix_bir_hwtcl
                                compare_parameters_value core${core}_msix_bir_hwtcl         core${core}_pf${i}_pci_msix_pba_hwtcl

                                compare_parameters_value core${core}_msix_bar_offset_hwtcl  core${core}_pf${i}_pci_msix_table_offset_hwtcl
                                compare_parameters_value core${core}_msix_bar_offset_hwtcl  core${core}_pf${i}_pci_msix_pba_offset_hwtcl

                            }
                        }
                        #VF
                        if {[get_parameter_value core${core}_enable_sriov_hwtcl]} {
                            if {[get_parameter_value core16_virtual_pf${i}_exvf_msix_cap_enable_hwtcl]} {
                            
                                compare_parameters_value core${core}_msix_table_size_hwtcl  core${core}_exvf_msix_tablesize_pf${i}

                                compare_parameters_value core${core}_msix_bir_hwtcl         core${core}_exvf_msixtable_bir_pf${i}
                                compare_parameters_value core${core}_msix_bir_hwtcl         core${core}_exvf_msixpba_bir_pf${i}

                                compare_parameters_value core${core}_msix_bar_offset_hwtcl  core${core}_exvf_msixtable_offset_pf${i}
                                compare_parameters_value core${core}_msix_bar_offset_hwtcl  core${core}_exvf_msixpba_offset_pf${i}

                            }
                        }
                        
                    }
            }
        }
    }

    proc ::intel_pcie_ss_axi::parameters::compare_parameters_value { PROP_NAME1 PROP_NAME2} {
    set tile [ip_get "parameter.TILE.value"]
    if {$tile == "P-TILE"} {

        set param_value1 [get_parameter_value $PROP_NAME1]
        set param_value2 [get_parameter_value $PROP_NAME2]

        if { [regexp "core16" $PROP_NAME1] } {
            set msix_table_size		[expr [ip_get "parameter.core16_msix_table_size_hwtcl.value"] - 1]
            set core 16
            set port "Port 0"
        } elseif { [regexp "core8" $PROP_NAME1] } {
            set msix_table_size		[expr [ip_get "parameter.core8_msix_table_size_hwtcl.value"] - 1]
            set core 8
            set port "Port 1"
        }
        
        if { [regexp "_pci_msix_table_size_hwtcl" $PROP_NAME2] || [regexp "_exvf_msix_tablesize_pf" $PROP_NAME2]} {
            if {[get_parameter_value core${core}_msix_vector_alloc_hwtcl] == "Dynamic"} {
                if { ($msix_table_size != 2047) || ($param_value2 != 2047) } {
                    ip_message error "${port} PCIe Subsystem MSIX and P-Tile PCIe MSIX Table should set to 2048 and 2047, respectively when PCIe Subsystem MSI-X Vector Allocation Policy is Dynamic. Please reconfigure."
                }
            } else {
                if { $msix_table_size != $param_value2} {
                    ip_message error "${port} P-Tile PCIe MSIX Table size mismatch with PCIe Subsystem MSIX Table size. Please reconfigure."
                }
            }
        }

        if { [regexp "_pci_msix_bir_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixtable_bir_pf" $PROP_NAME2]} {
            if {$param_value1 != $param_value2} {
                ip_message error "${port} P-Tile PCIe MSIX Table BAR indicator mismatch with PCIe Subsystem MSIX BIR. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_pba_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixpba_bir_pf" $PROP_NAME2]} {
            if {$param_value1 != $param_value2} {
                ip_message error "${port} P-Tile PCIe MSIX PBA BAR indicator mismatch with PCIe Subsystem MSIX BIR. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_table_offset_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixtable_offset_pf" $PROP_NAME2]} {
            if {[expr $param_value1 >> 3] != $param_value2} {
                ip_message error "${port} P-Tile PCIe MSIX Table offset mismatch with PCIe Subsystem MSIX BAR offset. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_pba_offset_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixpba_offset_pf" $PROP_NAME2]} {
            if {[expr ($param_value1 + (($msix_table_size+1)*16) ) >> 3 ] != $param_value2} {
                ip_message error "${port} P-Tile PCIe MSIX PBA offset mismatch with PCIe Subsystem MSIX BAR offset. Please reconfigure."
            }
        }
    
    } elseif {$tile == "F-TILE"} {
    	set param_value1 [get_parameter_value $PROP_NAME1]
        set param_value2 [get_parameter_value $PROP_NAME2]

        if { [regexp "core16" $PROP_NAME1] } {
            set msix_table_size		[expr [ip_get "parameter.core16_msix_table_size_hwtcl.value"] - 1]
            set core 16
            set port "Port 0"
        } elseif { [regexp "core8" $PROP_NAME1] } {
            set msix_table_size		[expr [ip_get "parameter.core8_msix_table_size_hwtcl.value"] - 1]
            set core 8
            set port "Port 1"
        }
        
        if { [regexp "_pci_msix_table_size_hwtcl" $PROP_NAME2] || [regexp "_exvf_msix_tablesize_pf" $PROP_NAME2]} {
            if {[get_parameter_value core${core}_msix_vector_alloc_hwtcl] == "Dynamic"} {
                if { ($msix_table_size != 2047) || ($param_value2 != 2047) } {
                    ip_message error "${port} PCIe Subsystem MSIX and F-Tile PCIe MSIX Table should set to 2048 and 2047, respectively when PCIe Subsystem MSI-X Vector Allocation Policy is Dynamic. Please reconfigure."
                }
            } else {
                if { $msix_table_size != $param_value2} {
                    ip_message error "${port} F-Tile PCIe MSIX Table size mismatch with PCIe Subsystem MSIX Table size. Please reconfigure."
                }
            }
        }

        if { [regexp "_pci_msix_bir_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixtable_bir_pf" $PROP_NAME2]} {
            if {$param_value1 != $param_value2} {
                ip_message error "${port} F-Tile PCIe MSIX Table BAR indicator mismatch with PCIe Subsystem MSIX BIR. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_pba_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixpba_bir_pf" $PROP_NAME2]} {
            if {$param_value1 != $param_value2} {
                ip_message error "${port} F-Tile PCIe MSIX PBA BAR indicator mismatch with PCIe Subsystem MSIX BIR. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_table_offset_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixtable_offset_pf" $PROP_NAME2]} {
            if {[expr $param_value1 >> 3] != $param_value2} {
                ip_message error "${port} F-Tile PCIe MSIX Table offset mismatch with PCIe Subsystem MSIX BAR offset. Please reconfigure."
            }
        }

        if { [regexp "_pci_msix_pba_offset_hwtcl" $PROP_NAME2] || [regexp "_exvf_msixpba_offset_pf" $PROP_NAME2]} {
            if {[expr ($param_value1 + (($msix_table_size+1)*16) ) >> 3 ] != $param_value2} {
                ip_message error "${port} F-Tile PCIe MSIX PBA offset mismatch with PCIe Subsystem MSIX BAR offset. Please reconfigure."
            }
        }
    }

  }

