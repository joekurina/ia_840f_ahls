    proc ::intel_pcie_ss_axi::parameters::validate_cpl_reordering {} {
     set topology [ip_get "parameter.top_topology_hwtcl.value"]

        switch $topology {
            "Gen5 1x16"    	{ set core_list [list "16"] }            
            "Gen5 2x8"	    { set core_list [list "16" "8"] }
            "Gen4 1x16"	    { set core_list [list "16"] }
            "Gen3 1x16"    	{ set core_list [list "16"] }
		    "Gen4 1x8"    	{ set core_list [list "16"] }
		    "Gen3 1x8"    	{ set core_list [list "16"] }
            "Gen4 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen3 2x8"    	{ set core_list [list "16" "8"] }
		    "Gen5 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
  		    "Gen4 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }
		    "Gen3 4x4"    	{ set core_list [list "16" "8" "4_0" "4_1"] }	
        }


        foreach core $core_list {
	        set cpl_reordering_en_value [ip_get "parameter.core${core}_cpl_reordering_en_hwtcl.value"]
            #set device_att_en_value     [ip_get "parameter.core${core}_device_att_en_hwtcl.value"]
            set core_value $core

            switch $core_value {
                "16"    {set port "0"}
                "8"     {set port "1"}
                "4_0"   {set port "2"}
                "4_1"   {set port "3"}
            }


            #if { $cpl_reordering_en_value && !$device_att_en_value } {   
                #send_message error "When Completion Reordering is enabled, PCIe${port} Device Address Translation Table must also be enabled"
            #}

            #TODO : To remove after Beta2 1.0
            #if { $cpl_reordering_en_value && !$low_latency_perf_en_value } {   
                #ip_message warning "In current release, Completion Reordering does not support PCIe${port} Low Latency Performance being disabled."
            #}
        }
    }  

    proc ::intel_pcie_ss_axi::parameters::virtual_tlp_bypass_en_user_hwtcl_reset_port_mode {arg} {
        set ip_topology [ip_get "parameter.top_topology_hwtcl.value"]
        set virtual_tlp_bypass_en_user_hwtcl [ip_get "parameter.virtual_tlp_bypass_en_user_hwtcl.value"]
        if { $virtual_tlp_bypass_en_user_hwtcl == 0} {
            if { [regexp "x8" $ip_topology ] } {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
            } elseif { [regexp "x4" $ip_topology ] } {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
            } else {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
            }
        } else {
            if {  [regexp "x16" $ip_topology] } {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Upstream" 
            } elseif {  [regexp "x8" $ip_topology] } {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Upstream / Upstream" 
            } elseif {  [regexp "x4" $ip_topology] } {
                ip_set_param "parameter.virtual_rp_ep_mode_hwtcl.value" "Upstream / Upstream / Upstream / Upstream" 
            }
        }

    }
   proc ::intel_pcie_ss_axi::parameters::virtual_rp_ep_mode_default {arg} {
      set ip_topology [ip_get "parameter.top_topology_hwtcl.value"]
      set virtual_rp_ep_mode_hwtcl [ip_get "parameter.virtual_rp_ep_mode_hwtcl.value"]
      if {$virtual_rp_ep_mode_hwtcl =="Root Port"} {
             ip_set_param "parameter.core16_virtual_pf0_msi_enable_user_hwtcl.value" 0
             ip_set_param "parameter.core16_virtual_pf0_msix_enable_user_hwtcl.value" 0
             ip_set_param "parameter.core16_pf0_pci_msix_table_size_hwtcl.value" 0
