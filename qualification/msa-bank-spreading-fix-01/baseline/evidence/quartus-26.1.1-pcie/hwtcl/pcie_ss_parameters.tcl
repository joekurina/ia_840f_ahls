    proc ::intel_pcie_ss_axi::parameters::validate_cpl_reordering_en_hwtcl { PROP_NAME PROP_VALUE } {
    	set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]

        if {$PROP_VALUE} {
            set en_dis "Enable"
        } else {
            set en_dis "Disable"
        }
    	if {$pcie_ss_func_mode_value == "Power User" } {
    		if {$PROP_VALUE} {
    			send_message error  "Completion Reordering is not supported in Power User Mode."
    		}
    	} else {
            switch $PROP_NAME {
                "core16_cpl_reordering_en_hwtcl"    { ip_set_param "parameter.core16_CPL_REORDERING.value" $en_dis  }
                "core8_cpl_reordering_en_hwtcl"		{ ip_set_param "parameter.core8_CPL_REORDERING.value"	$en_dis  }
                "core4_0_cpl_reordering_en_hwtcl"   { ip_set_param "parameter.core4_0_CPL_REORDERING.value" $en_dis }
                "core4_1_cpl_reordering_en_hwtcl"   { ip_set_param "parameter.core4_1_CPL_REORDERING.value" $en_dis }
            }
        }
    }

