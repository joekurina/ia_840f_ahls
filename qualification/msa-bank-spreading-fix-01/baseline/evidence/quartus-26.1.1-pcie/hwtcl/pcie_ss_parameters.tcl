    proc ::intel_pcie_ss_axi::parameters::_validate_timeout_inf { arg } {
    set cpl_timeout_thru_axist_value [ip_get "parameter.${arg}.value"] 
        
        if {[regexp "core16" $arg]} {
            set comp_timeout_inf_value [ip_get "parameter.core16_comp_timeout_en_hwtcl.value"]
            if {$cpl_timeout_thur_axist_value && $comp_timeout_inf_value } {
                ip_set_param "parameter.core16_comp_timeout_en_hwtcl.value" 0
                ip_message info "Enabling PCIe0 Completion Timeout throught AXI-ST Interface automatically disables PCIe0 Completion Timeout Interface. The two are mutually exclusive."   
            } 
        }

        if {[regexp "core8" $arg]} {
            set comp_timeout_inf_value [ip_get "parameter.core8_comp_timeout_en_hwtcl.value"]	
             if {$cpl_timeout_thru_axist_value && $comp_timeout_inf_value } {    
                ip_set_param "parameter.core8_comp_timeout_en_hwtcl.value" 0
                ip_message info "Enabling PCIe1 Completion Timeout throught AXI-ST Interface automatically disables PCIe1 Completion Timeout Interface. The two are mutually exclusive."   
            } 
        }

        if {[regexp "core4_0" $arg]} {
            set comp_timeout_inf_value [ip_get "parameter.core4_0_comp_timeout_en_hwtcl.value"]
            if {$cpl_timeout_thru_axist_value && $comp_timeout_inf_value } {	
                ip_set_param "parameter.core4_0_comp_timeout_en_hwtcl.value" 0
                ip_message info "Enabling PCIe2 Completion Timeout throught AXI-ST Interface automatically disables PCIe2 Completion Timeout Interface. The two are mutually exclusive."   
            } 				
	    }
 
        if {[regexp "core4_1" $arg]} {	
            set comp_timeout_inf_value [ip_get "parameter.core4_1_comp_timeout_en_hwtcl.value"]
            if {$cpl_timeout_thru_axist_value && $comp_timeout_inf_value } {   
                ip_set_param "parameter.core4_1_comp_timeout_en_hwtcl.value" 0
                ip_message info "Enabling PCIe3 Completion Timeout throught AXI-ST Interface automatically disables PCIe3 Completion Timeout Interface. The two are mutually exclusive."   
            } 				
	    }
    }

    proc ::intel_pcie_ss_axi::parameters::validate_pcie_ss_func_mode_hwtcl { PROP_NAME PROP_VALUE } {
        switch $PROP_VALUE {
            "Power User"      	    { set func_mode "POWER_USER" }
            "AXI-ST Data Mover"    	{ set func_mode "AXIST_DM" }
            "AXI-MM Data Mover"    	{ set func_mode "AXIMM_DM" }
