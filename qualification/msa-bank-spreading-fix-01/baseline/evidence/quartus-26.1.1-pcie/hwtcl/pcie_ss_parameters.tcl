    proc ::intel_pcie_ss_axi::parameters::validate_virtual_port_type_hwtcl { PROP_NAME PROP_VALUE hssi_ctp_func_mode } {
        set tile [ip_get "parameter.TILE.value"]
        if {$tile == "P-TILE"} {
            if { [regexp "updp" $hssi_ctp_func_mode] || [regexp "rpep" $hssi_ctp_func_mode]  } {
            ip_set_param "parameter.$PROP_NAME.value" "rpep_mix"
            } elseif { [regexp "ep" $hssi_ctp_func_mode] || [regexp "up" $hssi_ctp_func_mode]  } {
            ip_set_param "parameter.$PROP_NAME.value" "ep"
            } else {
            ip_set_param "parameter.$PROP_NAME.value" "rp"
            }
        } 
    }
    
    proc ::intel_pcie_ss_axi::parameters::validate_virtual_rp_ep_mode_hwtcl { PROP_NAME PROP_VALUE  virtual_tlp_bypass_en_user_hwtcl top_topology_hwtcl} {
    	set topo_r_enabled [get_quartus_ini "topo_r_enabled" ENABLED]
    	
	if { $virtual_tlp_bypass_en_user_hwtcl == 0} {
     set tile [ip_get "parameter.TILE.value"]
     if {$tile == "R-TILE"} {
		if { [regexp "x8" $top_topology_hwtcl ] } {
			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
       		} elseif { [regexp "x4" $top_topology_hwtcl ] } {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
       		} else {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
       		}
     } elseif {$tile =="P-TILE"} {
            if { [regexp "x8" $top_topology_hwtcl ] } {
			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint"}
       		} elseif { [regexp "x4" $top_topology_hwtcl ] } {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Root Port"}
       		} else {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
       		}
     } elseif {$tile =="F-TILE"} {
            if { [regexp "2x8" $top_topology_hwtcl ] } {
			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
            } elseif { [regexp "1x8" $top_topology_hwtcl ]} {
            ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
        	} elseif { [regexp "4x4" $top_topology_hwtcl ] } {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Root Port"} 
            } elseif { [regexp "1x4" $top_topology_hwtcl ] } {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
            } elseif { [regexp "2x4" $top_topology_hwtcl ] } {
		if { $topo_r_enabled == 1 } {
       			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
		} else {

       			ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Root Port"}

		}

		if { $PROP_VALUE == "Native Endpoint" } {
		 	ip_set_param "parameter.core16_enable_cii_hwtcl.value" 0
			ip_set_param "parameter.core16_enable_cpl_timeout_hwtcl.value" 0
         		ip_set_param "parameter.core16_enable_prs_event_hwtcl.value" 0
			ip_set_param "parameter.core4_0_enable_cii_hwtcl.value" 0
			ip_set_param "parameter.core4_0_enable_cpl_timeout_hwtcl.value" 0
        		ip_set_param "parameter.core4_0_enable_prs_event_hwtcl.value" 0
         		ip_set_param "parameter.core16_enable_legacy_int_hwtcl.value" 0
         		ip_set_param "parameter.core4_0_enable_legacy_int_hwtcl.value" 0
         		#ip_set_param "parameter.core4_0_enable_power_mgnt_intf_hwtcl.value" 0
			ip_set_param "parameter.core4_0_pf0_bar1_address_width_hwtcl.value" 0
			ip_set_param "parameter.core4_0_pf0_bar2_address_width_hwtcl.value" 0
			ip_set_param "parameter.core4_0_pf0_bar3_address_width_hwtcl.value" 0
			ip_set_param "parameter.core4_0_pf0_bar4_address_width_hwtcl.value" 0
			ip_set_param "parameter.core4_0_pf0_bar5_address_width_hwtcl.value" 0
		}
       		} else {
       		ip_set_param "parameter.$PROP_NAME.ALLOWED_RANGES" {"Native Endpoint" "Root Port"}
       		}
     }
       		::intel_pcie_ss_axi::parameters::set_core16_parameter_value core16_virtual_rp_ep_mode_hwtcl $PROP_VALUE
       		::intel_pcie_ss_axi::parameters::set_core8_parameter_value core8_virtual_rp_ep_mode_hwtcl $PROP_VALUE
       		::intel_pcie_ss_axi::parameters::set_core4_1_parameter_value core4_1_virtual_rp_ep_mode_hwtcl $PROP_VALUE
       		::intel_pcie_ss_axi::parameters::set_core4_0_parameter_value core4_0_virtual_rp_ep_mode_hwtcl $PROP_VALUE
       
       		if { [regexp "x16" $top_topology_hwtcl] } {
       			if { [regexp "Root Port" $PROP_VALUE] } {
       				ip_set "parameter.core16_virtual_rp_ep_mode_hwtcl.value" "Root Port"
       				ip_set "parameter.core8_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_0_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_1_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       			} else {
       				ip_set "parameter.core16_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core8_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_0_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_1_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       			}
       		} elseif { [regexp "x8" $top_topology_hwtcl] } {
       			if { [regexp "Root Port" $PROP_VALUE] } {
       				ip_set "parameter.core16_virtual_rp_ep_mode_hwtcl.value" "Root Port"
       				ip_set "parameter.core8_virtual_rp_ep_mode_hwtcl.value" "Root Port"
       				ip_set "parameter.core4_0_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_1_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       			} else {
       				ip_set "parameter.core16_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core8_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
       				ip_set "parameter.core4_0_virtual_rp_ep_mode_hwtcl.value" "Native Endpoint"
