	set core4_1_seg [expr $core4_1_DWIDTH/8/$core4_1_segment_size_hwtcl]
	
	switch $PROP_NAME {
		"core16_NUM_OF_SEG"      	{ ip_set_param "parameter.core16_NUM_OF_SEG.value" 	 $core16_seg  }
        "core8_NUM_OF_SEG"		    { ip_set_param "parameter.core8_NUM_OF_SEG.value"	 $core8_seg  }
		"core4_0_NUM_OF_SEG"		{ ip_set_param "parameter.core4_0_NUM_OF_SEG.value" $core4_0_seg }
		"core4_1_NUM_OF_SEG"		{ ip_set_param "parameter.core4_1_NUM_OF_SEG.value" $core4_1_seg }
	}    	    
  	    
    }

   
    # QHIP parameters validation
    proc ::intel_pcie_ss_axi::parameters::validate_core_pcie_ss_parameter { PROP_NAME PROP_VALUE } {
        set tile [ip_get "parameter.TILE.value"]
        set topo [ip_get "parameter.top_topology_hwtcl.value"]
        set virtual_rp_ep_mode [ip_get "parameter.virtual_rp_ep_mode_hwtcl.value"]
    
        if {$tile == "P-TILE" || $tile == "F-TILE"} {
            if {$virtual_rp_ep_mode == "Native Endpoint"} {
                # Escape for Ftile 2x4 EP
                if { !($tile == "F-TILE" && $topo == "Gen4 2x4" && $virtual_rp_ep_mode == "Native Endpoint") } {
                    if { !$PROP_VALUE } {
                        ip_message error "The PCIe Port settings, $PROP_NAME required by PCIe Subsystem are disabled"
                    }
                } else {
                    # Set for Ftile 2x4EP
                    if { $PROP_NAME == "core4_0_enable_cpl_timeout_hwtcl" } {
                        ip_set_param "parameter.core4_0_enable_cpl_timeout_hwtcl.value" 0
                    }
                }
            }
        }
    }
    
