    proc ::intel_pcie_ss_axi::parameters::core16_total_pf_count_hwtcl_reset_default {arg} {
    set tile [ip_get "parameter.TILE.value"]
    
        #puts "JOHNNY GUI PERF DEBUG: resetting core16 pf_count"
        set pcie_ss_func_mode_value [ip_get "parameter.pcie_ss_func_mode_hwtcl.value"]
        set core16_total_pf_count_hwtcl [ip_get "parameter.core16_total_pf_count_hwtcl.value"]
	set sriov_enable                [ip_get "parameter.core16_enable_sriov_hwtcl.value"]

        set GUI_parameters [ip_get_matching_parameters [dict set criteria M_IP_CORE "NOVAL" ]]
        foreach parameter $GUI_parameters {
            if {[string first "core16" $parameter] != -1} {
		if {$tile == "P-TILE"} {
                set pf_match [regexp {pf(.)_} $parameter match pf_num]
		} elseif {$tile == "F-TILE"  || $tile == "R-TILE"} {
		set pf_match [regexp {pf([\d])(.*)_} $parameter match pf_num]
		}
                if {$pf_match} {
                    if {$pf_num >= $core16_total_pf_count_hwtcl} {
                        set default_val [ip_get "parameter.${parameter}.DEFAULT_VALUE"]
                        ip_set_param "parameter.${parameter}.value" $default_val
                    }
                }
            }
        }
        
        for {set pf 1} {$pf < $core16_total_pf_count_hwtcl} {incr pf 1} {
            # check if this PF BAR is newly enabled, if yes then set bar0 to default value
            set already_set 0
            for {set i 0} {$i <= 5} {incr i 1} {
                set core16_pf_bar_type_user_hwtcl [ ip_get "parameter.core16_pf${pf}_bar${i}_type_user_hwtcl.value" ]
                  if { $core16_pf_bar_type_user_hwtcl != "Disabled" } {
                    set already_set 1
                    
                    break
                }
            }
            if { !$already_set } {
               
                ip_set_param "parameter.core16_pf${pf}_bar0_type_user_hwtcl.value" "64-bit prefetchable memory"
                ip_set_param "parameter.core16_pf${pf}_bar0_address_width_user_hwtcl.value" 16  
