def persist(): (R/"status.json").write_text(json.dumps(result,indent=2)+"\n")

def live_group(gid):
 out=[]
 for p in Path("/proc").iterdir():
  if not p.name.isdigit():continue
  try:
   parts=(p/"stat").read_text().rsplit(")",1)[1].split()
   if int(parts[2])==gid and parts[0]!="Z":out.append(int(p.name))
  except (FileNotFoundError,ProcessLookupError,PermissionError):pass
 return out

def limit_child():
 os.sched_setaffinity(0,cpus)
 resource.setrlimit(resource.RLIMIT_AS,(16*1024**3,16*1024**3))
 resource.setrlimit(resource.RLIMIT_CORE,(0,0))

def native(label,argv):
 rec={"label":label,"argv":argv,"started":datetime.now(timezone.utc).isoformat()};result["commands"].append(rec);persist()
 timedout=False;descendants_after_leader=False;p=None
 with (R/(label+".log")).open("xb") as log:
  try:
   p=subprocess.Popen(argv,cwd=R,env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,preexec_fn=limit_child)
   rec["pid"]=p.pid;rec["start_ticks"]=(Path("/proc")/str(p.pid)/"stat").read_text().rsplit(")",1)[1].split()[19];persist()
   deadline=time.monotonic()+600
   while os.waitid(os.P_PID,p.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT) is None:
    if time.monotonic()>deadline:timedout=True;break
    time.sleep(0.1)
   residual=live_group(p.pid)
   rec["descendants_observed_at_leader_exit"]=residual
   # Native frontends can finish just before their short-lived helpers.
   while residual and not timedout and time.monotonic()<deadline:
    time.sleep(0.1);residual=live_group(p.pid)
   if residual:timedout=True
   descendants_after_leader=bool(residual)

  finally:
   if p is not None:
    # Leader remains unreaped until all possible process-group signals finish.
    if live_group(p.pid):
     os.killpg(p.pid,signal.SIGTERM);end=time.monotonic()+3
     while live_group(p.pid) and time.monotonic()<end:time.sleep(0.1)
     if live_group(p.pid):os.killpg(p.pid,signal.SIGKILL)
    rec["native_rc"]=p.wait();rec["timeout"]=timedout;rec["descendants_after_leader"]=descendants_after_leader
    rec["ended"]=datetime.now(timezone.utc).isoformat();persist()
    rec["owned_group_live_after"]=live_group(p.pid)
    rec["effective_rc"]=124 if timedout else (125 if descendants_after_leader or rec["owned_group_live_after"] else rec["native_rc"])
    persist()
 return rec["effective_rc"]
error_pattern=re.compile(r"\b(?:Error|Fatal)(?:\s+\([^)]*\))?\s*:",re.I)
try:
 persist()
 commands=[("import",[C["tools"]["qsys-script"]["path"],"--quartus-project="+str(R/"ahls_memory_dma_fabric.qpf"),"--rev=ahls_memory_dma_fabric","--package-version=25.1","--search-path="+str(D)+","+str(R)+",$","--script="+str(R/"make-system.tcl")]),("generate",[C["tools"]["qsys-generate"]["path"],str(R/"ahls_memory_dma_fabric.qsys"),"--synthesis=VERILOG","--quartus-project="+str(R/"ahls_memory_dma_fabric.qpf"),"--rev=ahls_memory_dma_fabric","--part=AGFB027R25A2E2V","--parallel=off","--search-path="+str(D)+","+str(R)+",$"])]
 for label,argv in commands:
  rc=native(label,argv)
  log=(R/(label+".log")).read_text(errors="replace")
  errors=[line for line in log.splitlines() if error_pattern.search(line)]
  if rc or errors or (label=="import" and not all(m in log for m in ("PD_VALIDATE_OK","PD_IMPORT_COMPLETE"))):
   result["step_rejected"]={"label":label,"effective_rc":rc,"errors":errors};break
 result["complete"]=True
except Exception as e:result["error"]=repr(e)
finally:
 result["postflight_errors"]=[]
 def bound(root,name,h):
  try:return hashlib.sha256((root/name).read_bytes()).hexdigest()==h
  except Exception as e:result["postflight_errors"].append({"path":str(root/name),"error":repr(e)});return False
 result["originals_unchanged"]=all([bound(S,n,e["sha256"]) for n,e in C["inventory"].items()])
 result["copied_inputs_unchanged"]=all([bound(D,n,C["candidate_sha256"] if n=="ip/lsu_ic_top.sv" else e["sha256"]) for n,e in C["inventory"].items()])
 result["script_unchanged"]=bound(R,"make-system.tcl",C["inputs"]["make-system.tcl"]["sha256"])
 result["component_unchanged"]=bound(R,"ia840f_ahls_memory_fabric_dma_hw.tcl",C["inputs"]["ia840f_ahls_memory_fabric_dma_hw.tcl"]["sha256"])
 result["tools_unchanged"]=all([bound(Path(i["path"]).parent,Path(i["path"]).name,i["sha256"]) for i in C["tools"].values()])
 result["files"]={};result["generated_inventory"]={}
 for p in sorted(R.rglob("*")):
  if p==R/"status.json" or not p.is_file() or p.is_relative_to(D) or p.is_relative_to(R/"home") or p.is_relative_to(R/"tmp"):continue
  b=p.read_bytes();name=str(p.relative_to(R));h=hashlib.sha256(b).hexdigest();result["generated_inventory"][name]={"bytes":len(b),"sha256":h}
  if p.suffix in (".qsys",".ip",".qip",".sopcinfo",".qsf",".qpf",".log",".rpt",".v",".sv") or p.name in ("ahls_memory_fabric.v","lsu_ic_top.sv"):
   assert len(b)<3000000
   result["files"][name]={"bytes":len(b),"sha256":h,"base64":base64.b64encode(b).decode()}
 result["native_steps_completed"]=len(result["commands"])==2 and all(x.get("effective_rc")==0 for x in result["commands"]) and "step_rejected" not in result and "error" not in result
 result["ended"]=datetime.now(timezone.utc).isoformat();persist()
 blob=gzip.compress(json.dumps(result,sort_keys=True).encode(),compresslevel=6,mtime=0)
 (R/"result.json.gz").write_bytes(blob);assert hashlib.sha256((R/"result.json.gz").read_bytes()).hexdigest()==hashlib.sha256(blob).hexdigest()
 subprocess.run(["tmux","load-buffer","-b","ia840f_memcore_gen_"+C["run"],"-"],input=blob,check=True)
 subprocess.run(["tmux","set-buffer","-b","ia840f_memcore_gen_"+C["run"]+"_sha256",hashlib.sha256(blob).hexdigest()],check=True)
 print("RESULT_SHA256="+hashlib.sha256(blob).hexdigest(),flush=True)
 print("NATIVE_STEPS_COMPLETED="+str(result["native_steps_completed"]),flush=True)
last=result["commands"][-1].get("effective_rc",125) if result["commands"] else 125
if not result["complete"] or not result["native_steps_completed"] or not all(result[k] for k in ("originals_unchanged","copied_inputs_unchanged","script_unchanged","tools_unchanged","component_unchanged")):last=last or 125
raise SystemExit(128-last if last<0 else last)
