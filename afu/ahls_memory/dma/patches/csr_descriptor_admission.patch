+        return (a[2:0] == 0) && ((a >> 3) <= DMA_WR_DEST_PERF_CNTR);
+    endfunction
+    function automatic bit csr_writable(input logic [63:0] a);
+        return a == 8*DMA_SRC_ADDR || a == 8*DMA_DEST_ADDR ||
+               a == 8*DMA_LENGTH || a == 8*DMA_DESCRIPTOR_CONTROL ||
+               a == 8*DMA_CONTROL;
