+        dst_start = {1'b0, 64'(dma_csr_map.descriptor.dest_addr)};
+        nbytes = 65'(dma_csr_map.descriptor.length) * AXI_MM_DATA_W_BYTES;
+        src_end = src_start + nbytes - 1;
+        dst_end = dst_start + nbytes - 1;
+        mode = command[27:26];
+        host_start = (mode == HOST_TO_DDR) ? src_start : dst_start;
+        host_end = (mode == HOST_TO_DDR) ? src_end : dst_end;
+        ddr_start = (mode == HOST_TO_DDR) ? dst_start : src_start;
+        ddr_end = (mode == HOST_TO_DDR) ? dst_end : src_end;
+        return src_fresh && dest_fresh && length_fresh &&
+               dma_csr_map.descriptor.length != 0 &&
+               dma_csr_map.descriptor.length <= MAX_DESCRIPTOR_BEATS &&
+               (src_start % AXI_MM_DATA_W_BYTES == 0) &&
+               (dst_start % AXI_MM_DATA_W_BYTES == 0) &&
+               (host_start >> HOST_ADDR_W) == 0 &&
+               (host_end >> HOST_ADDR_W) == 0 &&
