@@ -258,7 +292,7 @@
          end
 
          state[WAIT_FOR_WR_RSP_BIT]: begin 
-            wr_fsm_done      = 1'b1;
+            wr_fsm_done      = responses_drained & !response_error & !response_bad;
             rd_fifo_if.rd_en = 1'b0;
 
          end
@@ -281,6 +315,8 @@
          wr_dest_valid_cnt   <= '0;
 
       end else begin
+         // Busy remains set for a descriptor held on error, not only bus traffic.
+         wr_dest_status.busy <= !next[IDLE_BIT];
          wr_dest_clk_cnt     <= (wr_dest_valid_cnt!=0) ? wr_dest_clk_cnt + 1 : wr_dest_clk_cnt;
          wr_dest_valid_cnt   <= wr_dest_valid_cnt + (dest_mem.wvalid & dest_mem.wready);
          
